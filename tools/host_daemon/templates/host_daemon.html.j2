    function fuzzyMatch(pattern, text) {
      if (!pattern) return true;
      let pIdx = 0;
      let tIdx = 0;
      const p = pattern.toLowerCase();
      const t = text.toLowerCase();
      while (pIdx < p.length && tIdx < t.length) {
        if (p[pIdx] === t[tIdx]) {
          pIdx++;
        }
        tIdx++;
      }
      return pIdx === p.length;
    }

    let fuzzySelectedIndex = 0;
    let currentFuzzyMatches = [];

    function openCliFuzzyHistory() {
      const container = document.getElementById("cliFuzzyHistory");
      const searchInput = document.getElementById("fuzzySearchInput");
      if (!container || !searchInput) return;

      container.style.display = "flex";
      searchInput.value = "";
      fuzzySelectedIndex = 0;
      updateFuzzyResults("");
      searchInput.focus();
    }

    function closeCliFuzzyHistory() {
      const container = document.getElementById("cliFuzzyHistory");
      if (container) {
        container.style.display = "none";
      }
      const cmdInput = document.getElementById("cmdInput");
      if (cmdInput) {
        cmdInput.focus();
      }
    }

    function updateFuzzyResults(query) {
      const list = document.getElementById("fuzzyResultsList");
      if (!list) return;

      const historyReversed = [];
      const seen = new Set();
      for (let i = cmdHistory.length - 1; i >= 0; i--) {
        const item = cmdHistory[i];
        if (item && !seen.has(item)) {
          seen.add(item);
          historyReversed.push(item);
        }
      }

      currentFuzzyMatches = historyReversed.filter(cmd => fuzzyMatch(query, cmd));
      if (fuzzySelectedIndex >= currentFuzzyMatches.length) {
        fuzzySelectedIndex = Math.max(0, currentFuzzyMatches.length - 1);
      }

      list.innerHTML = "";
      if (currentFuzzyMatches.length === 0) {
        const emptyDiv = document.createElement("div");
        emptyDiv.className = "fuzzy-item";
        emptyDiv.style.color = "var(--xerxes-text-dim, #567)";
        emptyDiv.innerText = "No matching commands";
        list.appendChild(emptyDiv);
        return;
      }

      currentFuzzyMatches.forEach((cmd, idx) => {
        const itemDiv = document.createElement("div");
        itemDiv.className = `fuzzy-item ${idx === fuzzySelectedIndex ? 'active' : ''}`;
        itemDiv.innerText = cmd;
        itemDiv.addEventListener("click", () => {
          selectFuzzyCommand(cmd);
        });
        list.appendChild(itemDiv);
      });

      const activeEl = list.children[fuzzySelectedIndex];
      if (activeEl) {
        activeEl.scrollIntoView({ block: "nearest" });
      }
    }

    function selectFuzzyCommand(cmd) {
      const input = document.getElementById("cmdInput");
      if (input) {
        input.value = cmd;
      }
      closeCliFuzzyHistory();
    }

    function setupCliFuzzyHistory() {
      const searchInput = document.getElementById("fuzzySearchInput");
      if (!searchInput) return;

      searchInput.addEventListener("input", (e) => {
        fuzzySelectedIndex = 0;
        updateFuzzyResults(e.target.value);
      });

      searchInput.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && (e.key === "r" || e.key === "R")) {
          e.preventDefault();
          if (currentFuzzyMatches.length > 0) {
            fuzzySelectedIndex = (fuzzySelectedIndex + 1) % currentFuzzyMatches.length;
            updateFuzzyResults(searchInput.value);
          }
          return;
        }

        if (e.key === "Escape") {
          e.preventDefault();
          closeCliFuzzyHistory();
        } else if (e.key === "Enter") {
          e.preventDefault();
          if (currentFuzzyMatches.length > 0 && currentFuzzyMatches[fuzzySelectedIndex]) {
            selectFuzzyCommand(currentFuzzyMatches[fuzzySelectedIndex]);
          } else {
            closeCliFuzzyHistory();
          }
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (currentFuzzyMatches.length > 0) {
            fuzzySelectedIndex = (fuzzySelectedIndex - 1 + currentFuzzyMatches.length) % currentFuzzyMatches.length;
            updateFuzzyResults(searchInput.value);
          }
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          if (currentFuzzyMatches.length > 0) {
            fuzzySelectedIndex = (fuzzySelectedIndex + 1) % currentFuzzyMatches.length;
            updateFuzzyResults(searchInput.value);
          }
        }
      });
    }

    document.getElementById("cmdInput").addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === "r" || e.key === "R")) {
        e.preventDefault();
        openCliFuzzyHistory();
        return;
      }
      if (e.key === "Enter") {
        e.preventDefault();
        submitCommand();
      } else if (e.key === "ArrowUp") {
        if (historyIdx > 0) {
          historyIdx--;
          document.getElementById("cmdInput").value = cmdHistory[historyIdx];
        }
      } else if (e.key === "ArrowDown") {
        if (historyIdx < cmdHistory.length - 1) {
          historyIdx++;
          document.getElementById("cmdInput").value = cmdHistory[historyIdx];
        } else {
          historyIdx = cmdHistory.length;
          document.getElementById("cmdInput").value = "";
        }
      }
    });

    // UI Scale Management (8715cab2)
    const UI_SCALES = ["75%", "80%", "90%", "100%", "110%", "125%", "150%"];
    const UI_SCALE_KEY = "ui_scale";

    function applyUiScale(scale) {
      if (!UI_SCALES.includes(scale)) {
        scale = "100%";
      }
      const factor = parseInt(scale, 10) / 100;
      if (document.documentElement) {
        document.documentElement.style.zoom = factor;
        if (factor === 1.0) {
          document.documentElement.style.width = "";
          document.documentElement.style.height = "";
        } else {
          document.documentElement.style.width = (window.innerWidth / factor) + "px";
          document.documentElement.style.height = (window.innerHeight / factor) + "px";
        }
      }
      try {
        localStorage.setItem(UI_SCALE_KEY, scale);
      } catch (e) {}
      const sel = document.getElementById("uiScaleSelect");
      if (sel && sel.value !== scale) {
        sel.value = scale;
      }
    }

    window.addEventListener("resize", () => {
      let current = "100%";
      try {
        current = localStorage.getItem(UI_SCALE_KEY) || "100%";
      } catch (e) {}
      const factor = parseInt(current, 10) / 100;
      if (factor !== 1.0 && document.documentElement) {
        document.documentElement.style.width = (window.innerWidth / factor) + "px";
        document.documentElement.style.height = (window.innerHeight / factor) + "px";
      }
    });

    function onUiScaleChange(scale) {
      applyUiScale(scale);
    }

    function adjustUiScale(delta) {
      let current = "100%";
      try {
        current = localStorage.getItem(UI_SCALE_KEY) || "100%";
      } catch (e) {}
      let idx = UI_SCALES.indexOf(current);
      if (idx === -1) idx = UI_SCALES.indexOf("100%");
      const nextIdx = Math.max(0, Math.min(UI_SCALES.length - 1, idx + delta));
      applyUiScale(UI_SCALES[nextIdx]);
    }

    function resetUiScale() {
      applyUiScale("100%");
    }

    function initUiScale() {
      let saved = "100%";
      try {
        saved = localStorage.getItem(UI_SCALE_KEY) || "100%";
      } catch (e) {}
      applyUiScale(saved);
    }

    window.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey) {
        if (e.key === "=" || e.key === "+" || e.code === "Equal" || e.code === "NumpadAdd") {
          e.preventDefault();
          adjustUiScale(1);
          return;
        }
        if (e.key === "-" || e.key === "_" || e.code === "Minus" || e.code === "NumpadSubtract") {
          e.preventDefault();
          adjustUiScale(-1);
          return;
        }
        if (e.key === "0" || e.code === "Digit0" || e.code === "Numpad0") {
          e.preventDefault();
          resetUiScale();
          return;
        }
      }
      if ((e.ctrlKey || e.metaKey) && (e.key === "r" || e.key === "R")) {
        if (e.target.id !== "fuzzySearchInput") {
          e.preventDefault();
          openCliFuzzyHistory();
        }
      }
    });

