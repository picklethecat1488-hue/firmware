        <div class="sync-info-row"><span>Profile:</span><strong>{{ 'release' if runner.release else 'debug' }}</strong></div>
        <div class="sync-info-row"><span>Speed:</span><strong>{{ runner.speed }} kHz</strong></div>
      </div>
      <div class="sync-status-indicator">
