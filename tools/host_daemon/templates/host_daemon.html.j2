      <div class="sync-modal-header" style="border-bottom: 2px solid var(--xerxes-red);">
        <span class="sync-modal-title" style="color: var(--xerxes-red);">🐞 TARGET DEFECT DISCOVERY // REPORT WORM</span>
        <button class="btn" style="padding: 2px 6px; font-size: 8.5px;" onclick="closeTargetBugModal()">✕</button>
      </div>
      <div style="display:flex; flex-direction:column; gap:10px; padding:14px; max-height:75vh; overflow-y:auto;">
        <div style="display:flex; gap:10px;">
          <div style="flex:2;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">BUG TITLE *</label>
            <input type="text" id="targetBugTitle" class="quake-input" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:11px; background:#040d12; border:1px solid #0b5966; color:#00f0ff;" placeholder="Brief summary of defect (e.g. Motor fails to spin on speed 100)...">
          </div>
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">SEVERITY</label>
            <select id="targetBugSeverity" class="select-dropdown" style="width:100%; height:28px;">
              <option value="CRITICAL">🔴 CRITICAL</option>
              <option value="HIGH">🟠 HIGH</option>
