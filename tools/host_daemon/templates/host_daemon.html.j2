        <div style="display:flex; gap:10px;">
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">COMPONENT</label>
            <input type="text" id="targetBugComponent" class="quake-input" style="width:100%; box-sizing:border-box; padding:5px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff;" value="target">
          </div>
          <div style="flex:2;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">TARGET DETAILS</label>
            <div style="font-size:9px; color:var(--xerxes-text-dim); padding-top:4px;">
              Target: <strong>{{ runner.target }}</strong> | Binary: <strong>{{ runner.bin_name }}</strong> ({{ 'release' if runner.release else 'debug' }})
            </div>
          </div>
