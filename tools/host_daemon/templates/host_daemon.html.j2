    async function submitTargetBug() {
      const title = document.getElementById("targetBugTitle")?.value.trim();
      const statusEl = document.getElementById("targetBugStatusMsg");
      const submitBtn = document.getElementById("btnSubmitTargetBug");
      const progressContainer = document.getElementById("targetBugProgressContainer");
      const progressBar = document.getElementById("targetBugProgressBar");
      const progressMsg = document.getElementById("targetBugProgressMsg");
      const progressPct = document.getElementById("targetBugProgressPct");

      function updateBugProgress(pct, msg) {
        if (progressContainer) progressContainer.style.display = "block";
        if (progressBar) progressBar.style.width = pct + "%";
        if (progressPct) progressPct.textContent = pct + "%";
        if (progressMsg) progressMsg.textContent = msg;
      }

      if (!title) {
        if (statusEl) {
          statusEl.style.display = "block";
          statusEl.style.background = "rgba(255, 42, 75, 0.15)";
          statusEl.style.color = "var(--xerxes-red)";
          statusEl.textContent = "Error: Bug title is required.";
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "⏳ Filing Bug Report...";
      }

      updateBugProgress(20, "Collecting system logs & target hardware context...");

      const payload = {
        title: title,
        severity: document.getElementById("targetBugSeverity")?.value || "MEDIUM",
        category: document.getElementById("targetBugCategory")?.value || "FIRMWARE",
        component: document.getElementById("targetBugComponent")?.value.trim() || "target",
        description: document.getElementById("targetBugDescription")?.value.trim() || "",
        reproduction_steps: document.getElementById("targetBugSteps")?.value.trim() || "",
        expected_behavior: document.getElementById("targetBugExpected")?.value.trim() || "",
        actual_behavior: document.getElementById("targetBugActual")?.value.trim() || "",
        attach_system_logs: document.getElementById("attachSystemLogs")?.checked ?? true,
        attach_crash_log: document.getElementById("attachCrashLog")?.checked ?? false,
        attach_telemetry: document.getElementById("attachTelemetry")?.checked ?? false,
        attach_metadata: document.getElementById("attachMetadata")?.checked ?? false,
        manual_attachments: targetBugAttachments,
      };

      try {
        updateBugProgress(45, "Packaging defect attachments & telemetry data...");
        const resp = await fetch("/api/target_bug", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        updateBugProgress(85, "Registering worm in tracking matrix...");
        const res = await resp.json();
        if (res.success) {
          updateBugProgress(100, `✓ Created defect report ${res.worm_id} with ${res.attachments_count} attachments.`);
          if (statusEl) {
            statusEl.style.display = "block";
            statusEl.style.background = "rgba(20, 217, 196, 0.15)";
            statusEl.style.color = "var(--xerxes-teal)";
            statusEl.textContent = `✓ Created defect report ${res.worm_id} with ${res.attachments_count} attachments.`;
          }
          setTimeout(() => {
            closeTargetBugModal();
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "⚡ File Target Bug";
            }
          }, 1500);
        } else {
          updateBugProgress(100, "Defect submission failed");
          if (progressBar) progressBar.style.background = "var(--xerxes-red)";
          if (statusEl) {
            statusEl.style.display = "block";
            statusEl.style.background = "rgba(255, 42, 75, 0.15)";
            statusEl.style.color = "var(--xerxes-red)";
            statusEl.textContent = `Error: ${res.error || "Failed to create bug report"}`;
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "⚡ File Target Bug";
          }
        }
      } catch (err) {
        updateBugProgress(100, "Defect submission failed");
        if (progressBar) progressBar.style.background = "var(--xerxes-red)";
        if (statusEl) {
          statusEl.style.display = "block";
          statusEl.style.background = "rgba(255, 42, 75, 0.15)";
          statusEl.style.color = "var(--xerxes-red)";
          statusEl.textContent = `Network error: ${err.message}`;
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "⚡ File Target Bug";
        }
      }
    }

    async function cancelSync() {
      const cancelBtn = document.getElementById("btnSyncCancel");
      if (cancelBtn) {
        cancelBtn.disabled = true;
        cancelBtn.innerText = "Cancelling...";
      }
      try {
        await fetch("/api/sync/cancel", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}"
        });
        setWorkstationDisabled(true, "Target sync cancelled. Click ⚡ Sync to re-synchronize before using CLI.");
      } catch (e) {
        console.error("Failed to cancel sync:", e);
      }
    }

    async function triggerSync() {
      openSyncModal();
      const dot = document.getElementById("syncStatusDot");
      const msg = document.getElementById("syncProgressMsg");
      const bar = document.getElementById("syncProgressBar");
      const pct = document.getElementById("syncProgressPct");
      const consoleEl = document.getElementById("syncConsoleLog");

      if (dot) {
        dot.className = "sync-status-dot pulse";
      }
      if (msg) msg.innerText = "Triggering target synchronization...";
      if (bar) bar.style.width = "5%";
      if (pct) pct.innerText = "5%";
      if (consoleEl) consoleEl.innerHTML = "";

      try {
        const resp = await fetch("/api/sync", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: "{}"
        });
        if (resp.ok) {
          startSyncPolling();
        } else {
          if (dot) dot.className = "sync-status-dot error";
          if (msg) msg.innerText = "Failed to trigger sync.";
          setWorkstationDisabled(true, "Sync failed to start. Click ⚡ Sync.");
        }
      } catch (e) {
        if (dot) dot.className = "sync-status-dot error";
        if (msg) msg.innerText = `Sync error: ${e}`;
        setWorkstationDisabled(true, "Sync error occurred. Click ⚡ Sync.");
      }
    }

    function startSyncPolling() {
      if (syncPollTimer) clearInterval(syncPollTimer);
      syncPollTimer = setInterval(pollSyncStatus, 500);
      pollSyncStatus();
    }

    async function pollSyncStatus() {
      try {
        const resp = await fetch("/api/sync/status");
        if (!resp.ok) return;
        const data = await resp.json();

        const dot = document.getElementById("syncStatusDot");
        const msg = document.getElementById("syncProgressMsg");
        const bar = document.getElementById("syncProgressBar");
        const pct = document.getElementById("syncProgressPct");
        const consoleEl = document.getElementById("syncConsoleLog");

        if (bar) bar.style.width = `${data.progress || 0}%`;
        if (pct) pct.innerText = `${data.progress || 0}%`;
        if (msg) msg.innerText = data.message || "Synchronizing...";

        if (consoleEl && data.console && Array.isArray(data.console)) {
          const shouldScroll = consoleEl.scrollTop + consoleEl.clientHeight >= consoleEl.scrollHeight - 30;
          consoleEl.innerHTML = data.console.map(line => ansiToHtml(line)).join("<br>");
          if (shouldScroll) {
            consoleEl.scrollTop = consoleEl.scrollHeight;
          }
        }

        if (data.step === "complete") {
          if (dot) dot.className = "sync-status-dot success";
          if (syncPollTimer) {
            clearInterval(syncPollTimer);
            syncPollTimer = null;
          }
          setWorkstationDisabled(false);
          pollOutputs();
          if (!syncAutoDismissTimer) {
            syncAutoDismissTimer = setTimeout(() => {
              closeSyncModal();
              syncAutoDismissTimer = null;
            }, 1500);
          }
        } else if (data.step === "cancelled") {
          if (dot) dot.className = "sync-status-dot error";
          if (syncPollTimer) {
            clearInterval(syncPollTimer);
            syncPollTimer = null;
          }
          setWorkstationDisabled(true, "Target sync cancelled. Click ⚡ Sync to re-synchronize before using CLI.");
        } else if (data.step === "failed") {
          if (dot) dot.className = "sync-status-dot error";
          if (syncPollTimer) {
            clearInterval(syncPollTimer);
            syncPollTimer = null;
          }
          setWorkstationDisabled(true, "Target sync failed. Click ⚡ Sync to retry.");
        } else {
          if (dot) dot.className = "sync-status-dot pulse";
        }
      } catch (e) {
        // Polling error
      }
    }

    initUiScale();
    setupSplitter();
    setupCliFuzzyHistory();
    setInterval(pollOutputs, 1000);
    pollOutputs();

    if (currentMode === "BRINGUP") {
      loadBringupScriptsList();
      pollBringupStatus();
    }

    // Check if initial synchronization is in progress on page load
    fetch("/api/sync/status").then(r => r.json()).then(data => {
      if (data && (data.active || (data.progress > 0 && data.progress < 100))) {
        openSyncModal();
        startSyncPolling();
      }
    }).catch(() => {});

    // Target Bug Dropzone & Clipboard Paste Setup (WORM-BRISTLY-GLOWWORM-390)
    const targetBugDropzoneEl = document.getElementById("targetBugDropzone");
    if (targetBugDropzoneEl) {
      targetBugDropzoneEl.addEventListener("dragover", (e) => {
        e.preventDefault();
        targetBugDropzoneEl.classList.add("dragover");
      });
      targetBugDropzoneEl.addEventListener("dragleave", (e) => {
        e.preventDefault();
        targetBugDropzoneEl.classList.remove("dragover");
      });
      targetBugDropzoneEl.addEventListener("drop", (e) => {
        e.preventDefault();
        targetBugDropzoneEl.classList.remove("dragover");
        if (e.dataTransfer && e.dataTransfer.files) {
          handleTargetBugFileUpload(e.dataTransfer.files);
        }
      });
    }

    window.addEventListener("paste", (e) => {
      const modal = document.getElementById("targetBugModal");
      if (!modal || modal.style.display === "none") return;
      if (e.clipboardData && e.clipboardData.items) {
        for (const item of e.clipboardData.items) {
          if (item.type.startsWith("image/")) {
            e.preventDefault();
            const blob = item.getAsFile();
            if (blob) {
              const reader = new FileReader();
              reader.onload = (evt) => {
                targetBugAttachments.push({
                  filename: `screenshot_${Date.now()}.png`,
                  file_type: "screenshot",
                  content_base64: evt.target.result,
                  size_bytes: blob.size,
                  description: "Pasted screenshot"
                });
                renderTargetBugAttachments();
              };
              reader.readAsDataURL(blob);
            }
            break;
          }
        }
      }
    });
  </script>
</body>
</html>
