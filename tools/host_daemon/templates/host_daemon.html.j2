  <main class="workspace-body">
    <!-- Left Panel: System / Target Logging -->
    <div class="panel-container log-panel" id="logPanel">
      <div class="panel-header">
        <span>SYSTEM LOGGING MONITOR (defmt / RTT)</span>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button class="btn btn-copy" id="btnCopyLog" onclick="copyPanelText('logView', this)" title="Copy log output">📋 Copy</button>
          <button class="btn btn-copy" id="btnCollapseLog" onclick="toggleLogPanel()" title="Hide logging monitor">◀ Hide</button>
          <span style="font-size: 8px; color: var(--xerxes-text-dim);">AUTO-SCROLL: ON</span>
        </div>
      </div>
      <div class="panel-content" id="logView">
        <div class="log-line log-line-info">> Host daemon online. Attached to {{ runner.package }}.</div>
      </div>
    </div>

    <!-- Draggable Vertical Splitter with Gripper -->
    <div class="vertical-splitter" id="vSplitter" title="Drag to resize panels">
      <div class="splitter-gripper"></div>
    </div>

    <!-- Right Panel: Interactive CLI & FS View -->
    <div class="panel-container cli-panel" id="cliPanel">
      <div class="panel-header">
        <span id="cliPanelTitle">INTERACTIVE CLI CONSOLE</span>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button class="btn btn-copy" id="btnCopyWorkstation" onclick="copyActiveWorkstationText(this)" title="Copy workstation output">📋 Copy</button>
          <span style="font-size: 8px; color: var(--xerxes-text-muted);" id="channelBadge">CHANNEL: BOTH</span>
        </div>
      </div>

      <!-- Optional FS Action Toolbar -->
      <div id="fsToolbar" class="fs-toolbar" style="display: {% if runner.active_mode == 'FS' %}flex{% else %}none{% endif %};">
        <span style="font-size: 8.5px; color: var(--xerxes-text-muted); margin-right: 4px;">Quick Actions:</span>
        <button class="btn btn-cyan" onclick="runFsQuick('ls')">ls</button>
        <button class="btn" onclick="runFsQuick('crash-log')">crash-log</button>
        <button class="btn" onclick="runFsQuick('cat metadata')">cat metadata</button>
        <button class="btn" onclick="runFsQuick('export-telemetry')">export-telemetry</button>
        <button class="btn" onclick="runFsQuick('format')">format</button>
      </div>

      <!-- Optional Bringup Action Toolbar -->
      <div id="bringupToolbar" class="bringup-toolbar" style="display: {% if runner.active_mode == 'BRINGUP' %}flex{% else %}none{% endif %};">
        <label for="bringupScriptSelect" style="font-size: 8.5px; color: var(--xerxes-text-muted);">SCRIPT:</label>
        <select id="bringupScriptSelect" class="select-dropdown" onchange="onBringupScriptSelected(this.value)">
          <option value="">Loading bringup scripts...</option>
        </select>
        <button class="btn btn-cyan" id="btnBringupStep" onclick="stepBringup()" title="Execute current checklist step">▶ Step</button>
        <button class="btn btn-cyan" id="btnBringupRun" onclick="runBringupAll()" title="Auto-run remaining checklist steps">⚡ Run All</button>
        <button class="btn btn-amber" id="btnBringupReset" onclick="resetBringup()" title="Reset checklist to step 1">↺ Reset</button>
        <button class="btn" id="btnBringupReport" onclick="exportBringupReport()" title="Export markdown verification report">📄 Report</button>
        <span id="bringupSummaryBadge" class="badge" style="margin-left: auto;">CHECKLIST: IDLE</span>
      </div>

      <div class="panel-content" id="cliView" style="display: {% if runner.active_mode in ('FS', 'BRINGUP') %}none{% else %}block{% endif %};">
        <div class="log-line log-line-info">> Interactive CLI workstation ready. Type commands below.</div>
      </div>

      <div class="panel-content" id="fsView" style="display: {% if runner.active_mode == 'FS' %}block{% else %}none{% endif %};">
        <div class="log-line log-line-info">> Filesystem (host_fs) workstation ready. Type FS commands below (e.g. 'ls', 'cat metadata', 'format').</div>
      </div>

      <div class="panel-content bringup-panel-content" id="bringupView" style="display: {% if runner.active_mode == 'BRINGUP' %}flex{% else %}none{% endif %}; flex-direction: row; padding: 0; overflow: hidden; height: 100%;">
        <!-- Left: Step list -->
        <div class="bringup-sidebar">
          <div class="bringup-sidebar-header">CHECKLIST STEPS</div>
          <ul class="bringup-step-list" id="bringupStepList">
            <li class="log-line log-line-info" style="padding: 8px;">Loading checklist steps...</li>
          </ul>
        </div>
        <!-- Right: Active Step Details, Prompt Card & Live CLI Output -->
        <div class="bringup-main-area">
          <div class="bringup-card bringup-prompt-card" id="bringupPromptCard">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span id="bringupCardTitle" style="font-weight: bold; color: var(--xerxes-cyan); font-size: 10px;">NO SCRIPT LOADED</span>
              <span id="bringupCardType" class="badge">TYPE: --</span>
            </div>
            <div id="bringupCardDesc" style="font-size: 8.5px; color: var(--xerxes-text-light); margin-bottom: 8px;">Select a bringup script above to begin verification.</div>
            <div id="bringupCardDetails" style="font-size: 8px; color: var(--xerxes-text-muted);"></div>
            <div id="bringupPromptActionArea" style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--xerxes-border-mid); display: none;">
              <div style="font-size: 8.5px; color: var(--xerxes-amber); font-weight: bold; margin-bottom: 6px;" id="bringupPromptText">ACTION REQUIRED: Verify step outcome</div>
              <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                <input type="text" id="bringupPromptNotes" class="cmd-input" placeholder="Notes/observations (optional)..." style="flex: 1; min-width: 160px; height: 22px; font-size: 8.5px;">
                <button class="btn btn-cyan" onclick="respondBringup('pass')">✔ Pass</button>
                <button class="btn btn-red" onclick="respondBringup('fail')">✘ Fail</button>
                <button class="btn btn-amber" onclick="respondBringup('skip')">⏭ Skip</button>
              </div>
            </div>
          </div>
          <div class="panel-header" style="background: var(--xerxes-header-bg); border-top: 1px solid var(--xerxes-border-mid); padding: 4px 8px;">
            <span style="font-size: 8.5px; color: var(--xerxes-cyan);">LIVE BRINGUP LOGS & CLI OUTPUT</span>
            <button class="btn btn-copy" onclick="copyBringupConsole(this)">📋 Copy Log</button>
          </div>
          <div class="panel-content" id="bringupConsoleOutput" style="flex: 1; overflow-y: auto; background: var(--xerxes-bg); border: 1px solid var(--xerxes-border-mid); padding: 6px; font-size: 8.5px; font-family: var(--font-mono);">
            <div class="log-line log-line-info">> Bringup workstation initialized.</div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="cli-input-bar">
    <div id="cliFuzzyHistory" class="cli-fuzzy-history" style="display:none;">
      <div class="fuzzy-header">
        <span class="fuzzy-prompt">(reverse-i-search)`':</span>
        <input type="text" id="fuzzySearchInput" class="fuzzy-search-input" placeholder="Search command history..." autocomplete="off">
        <button class="btn" style="padding: 1px 6px; font-size: 8.5px;" onclick="closeCliFuzzyHistory()">✕</button>
      </div>
      <div id="fuzzyResultsList" class="fuzzy-results-list"></div>
    </div>
    <span class="prompt-label" id="promptLabel">{% if runner.active_mode == 'FS' %}fs> {% else %}shell> {% endif %}</span>
    <input type="text" id="cmdInput" class="cmd-input" placeholder="{% if runner.active_mode == 'FS' %}Type FS command (e.g. 'ls', 'cat metadata', 'crash-log', 'format')...{% else %}Type shell command (e.g. 'motor speed 100', 'gpio status', 'battery status')...{% endif %}" autofocus autocomplete="off">
    <button class="btn btn-cyan" id="btnSubmitCmd" onclick="submitCommand()">Send [↵]</button>
  </footer>

  <script>
    let currentMode = "{{ runner.active_mode }}";
    let cmdHistory = [];
    let historyIdx = -1;

    async function changeMode(newMode) {
      currentMode = newMode;
      const cliView = document.getElementById("cliView");
      const fsView = document.getElementById("fsView");
      const bringupView = document.getElementById("bringupView");
      const fsToolbar = document.getElementById("fsToolbar");
      const bringupToolbar = document.getElementById("bringupToolbar");
      const promptLabel = document.getElementById("promptLabel");
      const cmdInput = document.getElementById("cmdInput");
      const title = document.getElementById("cliPanelTitle");

      if (currentMode === "FS") {
        if (cliView) cliView.style.display = "none";
        if (fsView) fsView.style.display = "block";
        if (bringupView) bringupView.style.display = "none";
        if (fsToolbar) fsToolbar.style.display = "flex";
        if (bringupToolbar) bringupToolbar.style.display = "none";
        if (promptLabel) promptLabel.innerText = "fs> ";
        if (title) title.innerText = "FILESYSTEM COMMAND WORKSTATION (host_fs)";
        if (cmdInput) cmdInput.placeholder = "Type FS command (e.g. 'ls', 'cat metadata', 'crash-log', 'format')...";
      } else if (currentMode === "BRINGUP") {
        if (cliView) cliView.style.display = "none";
        if (fsView) fsView.style.display = "none";
        if (bringupView) bringupView.style.display = "flex";
        if (fsToolbar) fsToolbar.style.display = "none";
        if (bringupToolbar) bringupToolbar.style.display = "flex";
        if (promptLabel) promptLabel.innerText = "bringup> ";
        if (title) title.innerText = "BRINGUP VERIFICATION CHECKLIST";
        if (cmdInput) cmdInput.placeholder = "Type shell/override command for active bringup step...";
        loadBringupScriptsList();
        pollBringupStatus();
      } else {
        if (cliView) cliView.style.display = "block";
        if (fsView) fsView.style.display = "none";
        if (bringupView) bringupView.style.display = "none";
        if (fsToolbar) fsToolbar.style.display = "none";
        if (bringupToolbar) bringupToolbar.style.display = "none";
        if (promptLabel) promptLabel.innerText = "shell> ";
        if (title) title.innerText = "INTERACTIVE CLI CONSOLE (host_cli)";
        if (cmdInput) cmdInput.placeholder = "Type shell command (e.g. 'motor speed 100', 'gpio status', 'battery status')...";
      }

      try {
        await fetch("/api/mode", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ mode: newMode })
        });
        pollOutputs();
      } catch (e) {
        console.error("Failed to update mode:", e);
      }
    }

    let lastBringupLogCount = 0;
    let isBringupRunning = false;

    async function loadBringupScriptsList() {
      try {
        const resp = await fetch("/api/bringup/scripts");
        if (!resp.ok) return;
        const scripts = await resp.json();
        const select = document.getElementById("bringupScriptSelect");
        if (!select) return;
        const currentVal = select.value;
        select.innerHTML = "";
        scripts.forEach(s => {
          const opt = document.createElement("option");
          opt.value = s.path;
          opt.textContent = `${s.name} (${s.chip}) - ${s.path}`;
          if (currentVal && opt.value === currentVal) opt.selected = true;
          select.appendChild(opt);
        });
        if (!currentVal && scripts.length > 0) {
          onBringupScriptSelected(scripts[0].path);
        }
      } catch (e) {
        console.error("Failed to load bringup scripts:", e);
      }
    }

    async function onBringupScriptSelected(scriptPath) {
      if (!scriptPath) return;
      try {
        const resp = await fetch("/api/bringup/load", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ script_path: scriptPath })
        });
        if (resp.ok) {
          pollBringupStatus();
        }
      } catch (e) {
        console.error("Failed to load selected bringup script:", e);
      }
    }

    async function pollBringupStatus() {
      if (currentMode !== "BRINGUP") return;
      try {
        const resp = await fetch("/api/bringup/status");
        if (!resp.ok) return;
        const data = await resp.json();
        renderBringupView(data);
      } catch (e) {
        console.error("Failed to poll bringup status:", e);
      }
    }

    function renderBringupView(data) {
      if (!data) return;

      const summaryBadge = document.getElementById("bringupSummaryBadge");
      if (summaryBadge && data.summary) {
        summaryBadge.textContent = `STEP ${data.current_step_idx + 1}/${data.total_steps} | ${data.summary.passed} PASSED, ${data.summary.failed} FAILED, ${data.summary.skipped} SKIPPED`;
        summaryBadge.className = data.summary.failed > 0 ? "badge badge-amber" : "badge badge-green";
      }

      const stepList = document.getElementById("bringupStepList");
      if (stepList && data.steps) {
        stepList.innerHTML = "";
        data.steps.forEach((step, idx) => {
          const li = document.createElement("li");
          const isActive = idx === data.current_step_idx;
          li.className = `bringup-step-item ${isActive ? "active" : ""}`;
          
          let statusBadgeClass = "badge";
          let statusIcon = "⏳";
          if (step.status === "passed") {
            statusBadgeClass = "badge badge-green";
            statusIcon = "✔";
          } else if (step.status === "failed") {
            statusBadgeClass = "badge badge-amber";
            statusIcon = "✘";
          } else if (step.status === "skipped") {
            statusBadgeClass = "badge";
            statusIcon = "⏭";
          } else if (step.status === "running") {
            statusBadgeClass = "badge badge-cyan";
            statusIcon = "⚙";
          }

          li.innerHTML = `
            <div style="display: flex; align-items: center; gap: 6px; overflow: hidden;">
              <span style="font-weight: bold; color: var(--xerxes-cyan);">${statusIcon} [${step.id}]</span>
              <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--xerxes-text-light);">${step.name}</span>
            </div>
            <span class="${statusBadgeClass}" style="font-size: 7.5px;">${step.type}</span>
          `;
          stepList.appendChild(li);
        });
      }

      const currStep = data.current_step;
      const cardTitle = document.getElementById("bringupCardTitle");
      const cardType = document.getElementById("bringupCardType");
      const cardDesc = document.getElementById("bringupCardDesc");
      const cardDetails = document.getElementById("bringupCardDetails");
      const promptActionArea = document.getElementById("bringupPromptActionArea");
      const promptText = document.getElementById("bringupPromptText");

      if (currStep) {
        if (cardTitle) cardTitle.textContent = `STEP ${currStep.id}: ${currStep.name.toUpperCase()}`;
        if (cardType) {
          cardType.textContent = `TYPE: ${currStep.type.toUpperCase()}`;
          cardType.className = "badge";
        }
        if (cardDesc) cardDesc.textContent = currStep.description || "No description provided for this step.";

        let detailsHtml = "";
        if (currStep.command) {
          detailsHtml += `<div style="margin-top: 4px;"><strong>Command:</strong> <code style="color: var(--xerxes-cyan);">${currStep.command}</code></div>`;
        }
        if (currStep.expected_regex) {
          detailsHtml += `<div style="margin-top: 4px;"><strong>Expected Regex:</strong> <code style="color: var(--xerxes-teal);">${currStep.expected_regex}</code></div>`;
        }
        if (currStep.matched_line) {
          detailsHtml += `<div style="margin-top: 4px; color: var(--xerxes-green);"><strong>Matched Output:</strong> <code>${currStep.matched_line}</code></div>`;
        }
        if (currStep.procedure) {
          detailsHtml += `<div style="margin-top: 4px;"><strong>Procedure:</strong> ${currStep.procedure}</div>`;
        }
        if (currStep.expected) {
          detailsHtml += `<div style="margin-top: 4px;"><strong>Expected Outcome:</strong> ${currStep.expected}</div>`;
        }

        if (currStep.test_points && Object.keys(currStep.test_points).length > 0) {
          detailsHtml += `<table class="bringup-table"><thead><tr><th>Test Point</th><th>Expected Voltage / Signal</th></tr></thead><tbody>`;
          for (const [tp, val] of Object.entries(currStep.test_points)) {
            detailsHtml += `<tr><td><strong>${tp}</strong></td><td>${val}</td></tr>`;
          }
          detailsHtml += `</tbody></table>`;
        }

        if (currStep.control_pins && Object.keys(currStep.control_pins).length > 0) {
          detailsHtml += `<table class="bringup-table"><thead><tr><th>Control Signal</th><th>Target Pin</th></tr></thead><tbody>`;
          for (const [cp, val] of Object.entries(currStep.control_pins)) {
            detailsHtml += `<tr><td><strong>${cp}</strong></td><td>${val}</td></tr>`;
          }
          detailsHtml += `</tbody></table>`;
        }

        if (cardDetails) cardDetails.innerHTML = detailsHtml;

        if (data.active_prompt) {
          if (promptActionArea) promptActionArea.style.display = "block";
          const p = data.active_prompt;
          let promptMsg = `ACTION REQUIRED: Verify step outcome (Default: ${p.default_status.toUpperCase()})`;
          if (p.auto_pass === true) {
            promptMsg = `✔ AUTOMATIC MATCH CONFIRMED (${p.matched_line || 'Pattern Matched'}). Click Pass to proceed.`;
          } else if (p.auto_pass === false) {
            promptMsg = `✘ AUTOMATIC MATCH FAILED: Expected pattern '${currStep.expected_regex}' not found.`;
          }
          if (promptText) promptText.textContent = promptMsg;
        } else {
          if (promptActionArea) promptActionArea.style.display = "none";
        }
      }

      const consoleOut = document.getElementById("bringupConsoleOutput");
      if (consoleOut && data.logs) {
        if (data.logs.length !== lastBringupLogCount) {
          consoleOut.innerHTML = "";
          data.logs.forEach(l => {
            const d = document.createElement("div");
            d.className = "log-line log-line-info";
            d.innerHTML = ansiToHtml(l);
            consoleOut.appendChild(d);
          });
          lastBringupLogCount = data.logs.length;
          consoleOut.scrollTop = consoleOut.scrollHeight;
        }
      }
    }

    async function stepBringup() {
      try {
        const resp = await fetch("/api/bringup/step", { method: "POST" });
        if (resp.ok) {
          pollBringupStatus();
        }
      } catch (e) {
        console.error("Failed to step bringup:", e);
      }
    }

    async function runBringupAll() {
      isBringupRunning = true;
      async function runNext() {
        if (!isBringupRunning) return;
        const statusResp = await fetch("/api/bringup/status");
        if (!statusResp.ok) return;
        const data = await statusResp.json();
        renderBringupView(data);

        if (data.status === "complete" || data.current_step_idx >= data.total_steps) {
          isBringupRunning = false;
          return;
        }

        if (data.status === "waiting_prompt") {
          if (data.active_prompt && data.active_prompt.auto_pass === true) {
            await respondBringup("pass");
            setTimeout(runNext, 200);
          } else {
            isBringupRunning = false;
          }
          return;
        }

        await stepBringup();
        setTimeout(runNext, 250);
      }
      runNext();
    }

    async function respondBringup(action) {
      const notesInput = document.getElementById("bringupPromptNotes");
      const notes = notesInput ? notesInput.value.trim() : "";
      try {
        const resp = await fetch("/api/bringup/respond", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: action, notes: notes })
        });
        if (notesInput) notesInput.value = "";
        if (resp.ok) {
          pollBringupStatus();
        }
      } catch (e) {
        console.error("Failed to respond to bringup prompt:", e);
      }
    }

    async function resetBringup() {
      isBringupRunning = false;
      try {
        const resp = await fetch("/api/bringup/reset", { method: "POST" });
        if (resp.ok) {
          pollBringupStatus();
        }
      } catch (e) {
        console.error("Failed to reset bringup:", e);
      }
    }

    async function exportBringupReport() {
      try {
        const resp = await fetch("/api/bringup/report", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ output_path: "bringup_report.md" })
        });
        const data = await resp.json();
        if (data && data.success) {
          alert(`Bringup report exported successfully to: ${data.output_path}`);
        }
      } catch (e) {
        console.error("Failed to export bringup report:", e);
      }
    }

    function copyBringupConsole(btn) {
      const consoleOut = document.getElementById("bringupConsoleOutput");
      if (!consoleOut) return;
      const text = consoleOut.innerText || "";
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.innerText;
        btn.innerText = "✔ Copied";
        setTimeout(() => btn.innerText = orig, 1500);
      });
    }

    function runFsQuick(action) {
      const input = document.getElementById("cmdInput");
      if (input && input.disabled) return;
      input.value = action;
      submitCommand();
    }

    function clearOutput() {
      lastLogCount = 0;
      lastCliCount = 0;
      lastFsCount = 0;
      const logView = document.getElementById("logView");
      if (logView) logView.innerHTML = "";
      const cliView = document.getElementById("cliView");
      if (cliView) cliView.innerHTML = "";
      const fsView = document.getElementById("fsView");
      if (fsView) fsView.innerHTML = "";
    }

    async function submitCommand() {
      const input = document.getElementById("cmdInput");
      const btn = document.getElementById("btnSubmitCmd");
      const fsToolbar = document.getElementById("fsToolbar");
      if (!input || input.disabled) return;
      const cmd = input.value.trim();
      if (!cmd) return;

      cmdHistory.push(cmd);
      historyIdx = cmdHistory.length;
      input.value = "";

      // Disable input and action buttons while command is executing
      input.disabled = true;
      if (btn) btn.disabled = true;
      if (fsToolbar) {
        fsToolbar.querySelectorAll("button").forEach(b => b.disabled = true);
      }
      const prevPlaceholder = input.placeholder;
      input.placeholder = `Running command: ${cmd}...`;
      input.style.opacity = "0.6";
      input.style.cursor = "wait";

      const endpoint = currentMode === "FS" ? "/api/fs/execute" : "/api/cli/execute";
      try {
        const resp = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ command: cmd })
        });
        const data = await resp.json();
        if (data && data.output && !data.output.startsWith("Dispatched:")) {
          if (currentMode === "FS") {
            appendFsText(data.output, false);
          } else {
            appendCliText(data.output, false);
            if (data.output.includes("Target CLI is not available")) {
              setWorkstationDisabled(true, "Target CLI is not available. Click ⚡ Sync to connect.");
            }
          }
        }
        pollOutputs();
        setTimeout(pollOutputs, 100);
        setTimeout(pollOutputs, 300);
      } catch (e) {
        if (currentMode === "FS") {
          appendFsText(`[ERROR] Command failed: ${e}`, false);
        } else {
          appendCliText(`[ERROR] Command failed: ${e}`, false);
        }
      } finally {
        if (!input.hasAttribute("data-prev-placeholder")) {
          input.disabled = false;
          if (btn) btn.disabled = false;
          if (fsToolbar) {
            fsToolbar.querySelectorAll("button").forEach(b => b.disabled = false);
          }
          input.placeholder = prevPlaceholder;
          input.style.opacity = "1";
          input.style.cursor = "text";
          input.focus();
        }
      }
    }

    const ANSI_FG_MAP = {
      30: 'term-fg-black', 31: 'term-fg-red', 32: 'term-fg-green', 33: 'term-fg-yellow',
      34: 'term-fg-blue', 35: 'term-fg-magenta', 36: 'term-fg-cyan', 37: 'term-fg-white',
      90: 'term-fg-bright-black', 91: 'term-fg-bright-red', 92: 'term-fg-bright-green', 93: 'term-fg-bright-yellow',
      94: 'term-fg-bright-blue', 95: 'term-fg-bright-magenta', 96: 'term-fg-bright-cyan', 97: 'term-fg-bright-white'
    };
    const ANSI_BG_MAP = {
      40: 'term-bg-black', 41: 'term-bg-red', 42: 'term-bg-green', 43: 'term-bg-yellow',
      44: 'term-bg-blue', 45: 'term-bg-magenta', 46: 'term-bg-cyan', 47: 'term-bg-white',
      100: 'term-bg-bright-black', 101: 'term-bg-bright-red', 102: 'term-bg-bright-green', 103: 'term-bg-bright-yellow',
      104: 'term-bg-bright-blue', 105: 'term-bg-bright-magenta', 106: 'term-bg-bright-cyan', 107: 'term-bg-bright-white'
    };

    function escapeHtmlText(str) {
      if (!str) return "";
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function formatTerminalLinks(escapedText) {
      const urlRe = /(https?:\/\/[^\s<>"'\)]+)/g;
      let res = escapedText.replace(urlRe, (url) => {
        return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="term-link">${url}</a>`;
      });

      const filePathRe = /(?<![a-zA-Z0-9_\-\.\/])((?:\/(?:Users|home|root|[a-zA-Z0-9_\-\.]+)\/[a-zA-Z0-9_\-\.\/]+)|(?:(?:src|tools|board|platform|controller|peripheral|tests|docs|attachments|feedback|target)\/[a-zA-Z0-9_\-\.\/]+))/g;
      const tokens = res.split(/(<[^>]+>)/);
      for (let i = 0; i < tokens.length; i++) {
        if (!tokens[i].startsWith('<')) {
          tokens[i] = tokens[i].replace(filePathRe, (m, path) => {
            let trailing = "";
            let p = path;
            while (p && ".,;:?)'\"]".includes(p[p.length - 1])) {
              trailing = p[p.length - 1] + trailing;
              p = p.slice(0, -1);
            }
            if (!p) return m;
            const fullPath = p.startsWith('/') ? p : `/${p}`;
            const vscodeUrl = `vscode://file${fullPath}`;
            return `<a href="${vscodeUrl}" class="term-link term-file-link" data-path="${p}">${p}</a>${trailing}`;
          });
        }
      }
      return tokens.join('');
    }

    function ansiToHtml(rawText) {
      if (!rawText) return "";

      // Handle carriage return overwrites within lines (e.g. interactive Cargo compile progress)
      if (rawText.includes('\r')) {
        const lines = rawText.split('\n');
        rawText = lines.map(line => {
          if (!line.includes('\r')) return line;
          const segments = line.split('\r').filter(Boolean);
          return segments.length > 0 ? segments[segments.length - 1] : "";
        }).join('\n');
      }

      // Normalize any orphaned / unprefixed / stripped OSC 8 hyperlink sequences (e.g. 8;;url...8;; or ]8;;url...]8;;)
      rawText = rawText.replace(/(?:\x1b\]|(?<![\w\[\]])\])?8;;([^\s`"\'<>\)\x1b\x07\\]+)(?:\x1b\\|\x07|\\)?(.*?)(?:\x1b\]|(?<![\w\[\]])\])?8;;(?:\x1b\\|\x07|\\)?/g, function(m, url, text) {
        return '\x1b]8;;' + url + '\x1b\\' + text + '\x1b]8;;\x1b\\';
      });

      const tokenRe = /(\x1b\[([0-9;]*)m|\x1b\]8;[^\x1b\x07]*;([^\x1b\x07]+)(?:\x1b\\|\x07)|\x1b\]8;[^\x1b\x07]*;(?:\x1b\\|\x07)|\x1b\][^\x1b\x07]*(?:\x1b\\|\x07)|\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])|[\x00-\x08\x0b-\x1a\x1c-\x1f])/g;

      let lastIndex = 0;
      let outChunks = [];
      let classes = [];
      let fgClass = null;
      let bgClass = null;
      let currentUrl = null;
      let match;

      while ((match = tokenRe.exec(rawText)) !== null) {
        let chunk = rawText.substring(lastIndex, match.index);
        lastIndex = tokenRe.lastIndex;

        if (chunk) {
          let escaped = escapeHtmlText(chunk);
          let inner = currentUrl ? escaped : formatTerminalLinks(escaped);
          let allCls = [...classes];
          if (fgClass) allCls.push(fgClass);
          if (bgClass) allCls.push(bgClass);

          let formatted = allCls.length > 0 ? `<span class="${allCls.join(' ')}">${inner}</span>` : inner;
          if (currentUrl) {
            if (currentUrl.startsWith("command:") || currentUrl.startsWith("action:")) {
              const cmd = currentUrl.replace(/^(command|action):/, "");
              formatted = `<a href="javascript:void(0)" onclick="handleCliCommandClick('${escapeHtmlText(cmd)}')" class="term-link term-cmd-link" data-command="${escapeHtmlText(cmd)}" title="Click to select ${escapeHtmlText(cmd)}">${formatted}</a>`;
            } else {
              formatted = `<a href="${escapeHtmlText(currentUrl)}" target="_blank" rel="noopener noreferrer" class="term-link">${formatted}</a>`;
            }
          }
          outChunks.push(formatted);
        }

        let fullTok = match[0];
        let sgrCode = match[2];
        let osc8Url = match[3];

        if (sgrCode !== undefined) {
          if (!sgrCode || sgrCode === '0') {
            classes = [];
            fgClass = null;
            bgClass = null;
          } else {
            let codes = sgrCode.split(';').map(c => parseInt(c, 10)).filter(c => !isNaN(c));
            codes.forEach(code => {
              if (code === 0) {
                classes = [];
                fgClass = null;
                bgClass = null;
              } else if (code === 1) {
                if (!classes.includes('term-bold')) classes.push('term-bold');
              } else if (code === 2) {
                if (!classes.includes('term-dim')) classes.push('term-dim');
              } else if (code === 3) {
                if (!classes.includes('term-italic')) classes.push('term-italic');
              } else if (code === 4) {
                if (!classes.includes('term-underline')) classes.push('term-underline');
              } else if (code === 21 || code === 22) {
                classes = classes.filter(c => c !== 'term-bold' && c !== 'term-dim');
              } else if (code === 23) {
                classes = classes.filter(c => c !== 'term-italic');
              } else if (code === 24) {
                classes = classes.filter(c => c !== 'term-underline');
              } else if (ANSI_FG_MAP[code]) {
                fgClass = ANSI_FG_MAP[code];
              } else if (code === 39) {
                fgClass = null;
              } else if (ANSI_BG_MAP[code]) {
                bgClass = ANSI_BG_MAP[code];
              } else if (code === 49) {
                bgClass = null;
              }
            });
          }
        } else if (osc8Url !== undefined) {
          currentUrl = osc8Url;
        } else if (fullTok.startsWith('\x1b]8;')) {
          currentUrl = null;
        }
      }

      let remaining = rawText.substring(lastIndex);
      if (remaining) {
        let escaped = escapeHtmlText(remaining);
        let inner = currentUrl ? escaped : formatTerminalLinks(escaped);
        let allCls = [...classes];
        if (fgClass) allCls.push(fgClass);
        if (bgClass) allCls.push(bgClass);

        let formatted = allCls.length > 0 ? `<span class="${allCls.join(' ')}">${inner}</span>` : inner;
        if (currentUrl) {
          if (currentUrl.startsWith("command:") || currentUrl.startsWith("action:")) {
            const cmd = currentUrl.replace(/^(command|action):/, "");
            formatted = `<a href="javascript:void(0)" onclick="handleCliCommandClick('${escapeHtmlText(cmd)}')" class="term-link term-cmd-link" data-command="${escapeHtmlText(cmd)}" title="Click to select ${escapeHtmlText(cmd)}">${formatted}</a>`;
          } else {
            formatted = `<a href="${escapeHtmlText(currentUrl)}" target="_blank" rel="noopener noreferrer" class="term-link">${formatted}</a>`;
          }
        }
        outChunks.push(formatted);
      }

      return outChunks.join('');
    }

    function handleCliCommandClick(cmd) {
      if (typeof respondBringup === "function" && ["pass", "fail", "skip"].includes(cmd.toLowerCase())) {
        respondBringup(cmd.toLowerCase());
        return;
      }
      const input = document.getElementById("cmdInput");
      if (input) {
        input.value = cmd;
        if (typeof submitCommand === "function") {
          submitCommand();
        }
      }
    }

    let lastLogCount = 0;
    let lastCliCount = 0;
    let lastFsCount = 0;

    function isSelectionInside(element) {
      if (!element) return false;
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return false;
      try {
        if (element.contains(sel.anchorNode) || element.contains(sel.focusNode)) {
          return true;
        }
        const range = sel.getRangeAt(0);
        return element.contains(range.commonAncestorContainer);
      } catch (e) {
        return false;
      }
    }

    async function copyPanelText(elementId, btn) {
      const el = document.getElementById(elementId);
      if (!el) return;
      const text = el.innerText || el.textContent || "";
      let copied = false;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          copied = true;
        } catch (e) {
          copied = false;
        }
      }
      if (!copied) {
        try {
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          copied = document.execCommand("copy");
          document.body.removeChild(ta);
        } catch (e) {
          console.error("Copy fallback error:", e);
        }
      }
      if (btn) {
        const orig = btn.innerText;
        btn.innerText = copied ? "✓ Copied!" : "Error";
        setTimeout(() => { btn.innerText = orig; }, 1500);
      }
    }

    function copyActiveWorkstationText(btn) {
      const mode = document.getElementById("modeSelect") ? document.getElementById("modeSelect").value : "CLI";
      const targetId = mode === "FS" ? "fsView" : "cliView";
      copyPanelText(targetId, btn);
    }

    let isLogHidden = false;
    let prevLogWidth = "50%";
    let isDraggingSplitter = false;

    function toggleLogPanel() {
      const logPanel = document.getElementById("logPanel");
      const splitter = document.getElementById("vSplitter");
      const toggleBtn = document.getElementById("btnToggleLog");
      const collapseBtn = document.getElementById("btnCollapseLog");
      if (!logPanel) return;

      isLogHidden = !isLogHidden;
      if (isLogHidden) {
        prevLogWidth = logPanel.style.width || "50%";
        logPanel.style.display = "none";
        if (splitter) splitter.style.display = "none";
        if (toggleBtn) {
          toggleBtn.innerText = "Show Log";
          toggleBtn.classList.add("btn-amber");
        }
        if (collapseBtn) {
          collapseBtn.innerText = "▶ Show";
        }
      } else {
        logPanel.style.display = "flex";
        logPanel.style.width = prevLogWidth;
        if (splitter) splitter.style.display = "flex";
        if (toggleBtn) {
          toggleBtn.innerText = "Hide Log";
          toggleBtn.classList.remove("btn-amber");
        }
        if (collapseBtn) {
          collapseBtn.innerText = "◀ Hide";
        }
      }
    }

    function setupSplitter() {
      const splitter = document.getElementById("vSplitter");
      const logPanel = document.getElementById("logPanel");
      const workspace = document.querySelector(".workspace-body");
      if (!splitter || !logPanel || !workspace) return;

      splitter.addEventListener("mousedown", (e) => {
        isDraggingSplitter = true;
        splitter.classList.add("dragging");
        document.body.style.cursor = "col-resize";
        document.body.style.userSelect = "none";
        e.preventDefault();
      });

      window.addEventListener("mousemove", (e) => {
        if (!isDraggingSplitter) return;
        const rect = workspace.getBoundingClientRect();
        const offsetX = e.clientX - rect.left;
        const totalWidth = rect.width - 16;
        if (offsetX < 30) {
          if (!isLogHidden) toggleLogPanel();
          return;
        } else if (isLogHidden) {
          toggleLogPanel();
        }
        const clampedWidth = Math.max(80, Math.min(totalWidth - 150, offsetX));
        const pct = (clampedWidth / totalWidth) * 100;
        logPanel.style.width = `${pct}%`;
      });

      window.addEventListener("mouseup", () => {
        if (isDraggingSplitter) {
          isDraggingSplitter = false;
          splitter.classList.remove("dragging");
          document.body.style.cursor = "";
          document.body.style.userSelect = "";
        }
      });
    }

    function appendCliText(text, isInput) {
      const view = document.getElementById("cliView");
      if (!view) return;
      const div = document.createElement("div");
      div.className = isInput ? "log-line cli-line-input" : "log-line cli-line-output";
      div.innerHTML = ansiToHtml(text);
      view.appendChild(div);
      view.scrollTop = view.scrollHeight;
      lastCliCount++;
    }

    function appendFsText(text, isInput) {
      const view = document.getElementById("fsView");
      if (!view) return;
      const div = document.createElement("div");
      div.className = isInput ? "log-line cli-line-input" : "log-line cli-line-output";
      div.innerHTML = ansiToHtml(text);
      view.appendChild(div);
      view.scrollTop = view.scrollHeight;
      lastFsCount++;
    }

    async function pollOutputs() {
      try {
        const logResp = await fetch("/api/logs");
        if (logResp.ok) {
          const logs = await logResp.json();
          const logView = document.getElementById("logView");
