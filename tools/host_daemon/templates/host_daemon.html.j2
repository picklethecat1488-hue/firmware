<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xerxes Host Daemon // {{ runner.package }}:{{ runner.bin_name }}</title>
  <meta name="theme-color" content="#0a1c24">
  <meta name="color-scheme" content="dark">
  <link rel="stylesheet" href="/static/common.css">
  <style>
    html { font-size: 80%; }
    :root {
      --xerxes-bg: #04090c;
      --xerxes-panel: #08161d;
      --xerxes-panel-hover: #0e242f;
      --xerxes-header-bg: #0a1c24;
      --xerxes-border-light: #00f0ff;
      --xerxes-border-mid: #0b5966;
      --xerxes-border-dark: #021217;
      --xerxes-cyan: #00f0ff;
      --xerxes-cyan-dim: #00a4b3;
      --xerxes-teal: #14d9c4;
      --xerxes-mint: #00ffb4;
      --xerxes-amber: #ffb000;
      --xerxes-red: #ff2a4b;
      --xerxes-green: #00ffb4;
      --xerxes-text-light: #e6f9ff;
      --xerxes-text-muted: #7aa5b0;
      --xerxes-text-dim: #3a626c;
      --font-mono: "Share Tech Mono", ui-monospace, "SF Mono", "Courier New", monospace;
    }
    html {
      height: 100%;
      width: 100%;
    }
    body {
      background-color: var(--xerxes-bg);
      background-image:
        repeating-linear-gradient(0deg, rgba(0,0,0,0.38) 0px, rgba(0,0,0,0.38) 2px, transparent 2px, transparent 4px),
        radial-gradient(ellipse at 50% 0%, #0a2f3a 0%, #03080b 100%);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      height: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    header {
      background: var(--xerxes-header-bg);
      border-bottom: 2px solid var(--xerxes-border-mid);
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .header-title {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--xerxes-cyan);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .badge {
      font-size: 8.5px;
      padding: 2px 6px;
      border-radius: 2px;
      background: rgba(0, 240, 255, 0.15);
      border: 1px solid var(--xerxes-cyan-dim);
      color: var(--xerxes-cyan);
    }
    .badge-green {
      background: rgba(0, 255, 180, 0.15);
      border-color: var(--xerxes-green);
      color: var(--xerxes-green);
    }
    .badge-amber {
      background: rgba(255, 176, 0, 0.15);
      border-color: var(--xerxes-amber);
      color: var(--xerxes-amber);
    }
    .select-dropdown {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-light);
      color: var(--xerxes-cyan);
      font-family: var(--font-mono);
      font-size: 8.5px;
      font-weight: bold;
      padding: 3px 6px;
      border-radius: 2px;
      cursor: pointer;
      outline: none;
    }
    .btn {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      font-size: 8.5px;
      font-weight: bold;
      padding: 3px 8px;
      border-radius: 2px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .btn:hover {
      background: var(--xerxes-panel-hover);
      border-color: var(--xerxes-cyan);
      color: var(--xerxes-cyan);
    }
    .btn-cyan {
      background: rgba(0, 240, 255, 0.2);
      border-color: var(--xerxes-cyan);
      color: var(--xerxes-cyan);
    }
    .btn-amber {
      background: rgba(255, 176, 0, 0.2);
      border-color: var(--xerxes-amber);
      color: var(--xerxes-amber);
    }
    .btn-amber:hover {
      background: rgba(255, 176, 0, 0.35);
      border-color: var(--xerxes-amber);
      color: #fff;
    }
    .btn-red {
      background: rgba(255, 42, 75, 0.2);
      border-color: var(--xerxes-red);
      color: var(--xerxes-red);
    }
    .btn-red:hover {
      background: rgba(255, 42, 75, 0.35);
      border-color: var(--xerxes-red);
      color: #fff;
    }
    .btn-copy {
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid var(--xerxes-cyan);
      color: var(--xerxes-cyan);
      padding: 1px 6px;
      font-size: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      border-radius: 2px;
      outline: none;
    }
    .btn-copy:hover {
      background: rgba(0, 240, 255, 0.25);
      color: #ffffff;
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.4);
    }
    .workspace-body {
      flex: 1;
      display: flex;
      flex-direction: row;
      gap: 0;
      padding: 8px;
      overflow: hidden;
      position: relative;
    }
    .log-panel {
      width: 50%;
      min-width: 0px;
      flex-shrink: 0;
    }
    .cli-panel {
      flex: 1;
      min-width: 200px;
    }
    .vertical-splitter {
      width: 10px;
      cursor: col-resize;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      user-select: none;
      flex-shrink: 0;
      margin: 0 4px;
      transition: background 0.15s ease;
      z-index: 10;
    }
    .vertical-splitter:hover, .vertical-splitter.dragging {
      background: rgba(0, 240, 255, 0.2);
    }
    .splitter-gripper {
      width: 2px;
      height: 40px;
      background: var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.6);
      border-radius: 1px;
      opacity: 0.6;
      transition: opacity 0.2s, height 0.2s;
    }
    .vertical-splitter:hover .splitter-gripper, .vertical-splitter.dragging .splitter-gripper {
      opacity: 1;
      height: 60px;
    }
    .panel-container {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      box-shadow: inset 1px 1px 0px rgba(0, 240, 255, 0.25), inset -1px -1px 0px var(--xerxes-border-dark);
      border-radius: 3px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .panel-header {
      background: rgba(10, 28, 36, 0.85);
      border-bottom: 1px solid var(--xerxes-border-mid);
      padding: 5px 10px;
      font-size: 9px;
      font-weight: bold;
      color: var(--xerxes-cyan);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .panel-content {
      display: block;
      flex: 1;
      flex-direction: column;
      overflow-y: auto;
      padding: 6px 8px;
      font-size: 9.5px;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .log-line {
      margin-bottom: 2px;
    }
    .log-line-error { color: var(--xerxes-red); }
    .log-line-warn { color: var(--xerxes-amber); }
    .log-line-info { color: var(--xerxes-text-light); }
    .log-line-target { color: var(--xerxes-mint); }
    .cli-line-input { color: var(--xerxes-cyan); font-weight: bold; }
    .cli-line-output { color: var(--xerxes-text-light); }
    .fs-toolbar {
      padding: 4px 8px;
      border-bottom: 1px solid var(--xerxes-border-dark);
      display: flex;
      gap: 6px;
      background: rgba(0, 240, 255, 0.05);
      align-items: center;
      flex-wrap: wrap;
    }
    footer.cli-input-bar {
      background: var(--xerxes-header-bg);
      border-top: 2px solid var(--xerxes-border-mid);
      padding: 6px 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      position: relative;
    }
    .prompt-label {
      color: var(--xerxes-cyan);
      font-weight: bold;
      font-size: 9.5px;
      white-space: nowrap;
    }
    .cmd-input {
      flex: 1;
      background: var(--xerxes-bg);
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      font-size: 9.5px;
      padding: 4px 8px;
      outline: none;
      border-radius: 2px;
    }
    .cmd-input:focus {
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.4);
    }

    /* CLI Fuzzy History Search (Ctrl-R) */
    .cli-fuzzy-history {
      position: absolute;
      bottom: 48px;
      left: 0;
      right: 0;
      max-height: 220px;
      background: var(--xerxes-panel, #08161d);
      border: 2px solid var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.9), 0 0 10px rgba(0, 240, 255, 0.2);
      z-index: 2500;
      display: flex;
      flex-direction: column;
    }
    .fuzzy-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 8px;
      background: rgba(10, 28, 36, 0.95);
      border-bottom: 1px solid var(--xerxes-border-mid, #0b5966);
    }
    .fuzzy-prompt {
      color: var(--xerxes-amber, #ffb000);
      font-weight: bold;
      font-size: 8.5px;
      white-space: nowrap;
    }
    .fuzzy-search-input {
      flex: 1;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-mid, #0b5966);
      color: var(--xerxes-text-light, #e6f9ff);
      font-family: var(--font-mono);
      font-size: 8.5px;
      padding: 3px 6px;
      outline: none;
    }
    .fuzzy-results-list {
      overflow-y: auto;
      max-height: 170px;
    }
    .fuzzy-item {
      padding: 4px 10px;
      font-size: 8.5px;
      font-family: var(--font-mono);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid rgba(11, 89, 102, 0.3);
      color: var(--xerxes-text-light, #e6f9ff);
    }
    .fuzzy-item:hover, .fuzzy-item.active {
      background: rgba(0, 240, 255, 0.2);
      color: var(--xerxes-cyan, #00f0ff);
      font-weight: bold;
    }

    /* Terminal Formatting & Coloration (VS Code Terminal Aesthetic) */
    .term-bold { font-weight: bold; }
    .term-dim { opacity: 0.7; }
    .term-italic { font-style: italic; }
    .term-underline { text-decoration: underline; }
    .term-fg-black { color: #5c6370; }
    .term-fg-red { color: #e06c75; }
    .term-fg-green { color: #98c379; }
    .term-fg-yellow { color: #e5c07b; }
    .term-fg-blue { color: #61afef; }
    .term-fg-magenta { color: #c678dd; }
    .term-fg-cyan { color: #56b6c2; }
    .term-fg-white { color: #dcdfe4; }
    .term-fg-bright-black { color: #7f848e; }
    .term-fg-bright-red { color: #ff6b68; }
    .term-fg-bright-green { color: #a8cc8c; }
    .term-fg-bright-yellow { color: #e5c07b; }
    .term-fg-bright-blue { color: #73b8ff; }
    .term-fg-bright-magenta { color: #d68ff0; }
    .term-fg-bright-cyan { color: #00f0ff; }
    .term-fg-bright-white { color: #ffffff; }
    .term-bg-black { background-color: #282c34; }
    .term-bg-red { background-color: #e06c75; }
    .term-bg-green { background-color: #98c379; }
    .term-bg-yellow { background-color: #e5c07b; }
    .term-bg-blue { background-color: #61afef; }
    .term-bg-magenta { background-color: #c678dd; }
    .term-bg-cyan { background-color: #56b6c2; }
    .term-bg-white { background-color: #dcdfe4; }
    .term-link {
      color: var(--xerxes-cyan, #00f0ff);
      text-decoration: underline;
      cursor: pointer;
    }
    .term-link:hover {
      color: #ffffff;
      text-shadow: 0 0 6px var(--xerxes-cyan, #00f0ff);
    }

    /* Modal Flashing Status Window & Progress Bar */
    .sync-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(4, 9, 12, 0.85);
      backdrop-filter: blur(4px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sync-modal-box {
      width: 780px;
      max-width: 95vw;
      max-height: 88vh;
      background: var(--xerxes-panel, #08161d);
      border: 2px solid var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.3), inset 0 0 15px rgba(0, 240, 255, 0.1);
      display: flex;
      flex-direction: column;
      padding: 16px;
      gap: 12px;
      border-radius: 4px;
    }
    .sync-console-container {
      width: 100%;
      height: 280px;
      max-height: 42vh;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-dark, #073840);
      border-radius: 2px;
      overflow-y: auto;
      font-family: var(--font-mono);
      font-size: 9px;
      line-height: 1.4;
      padding: 6px 8px;
      color: var(--xerxes-text-light, #e6f9ff);
      box-sizing: border-box;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .sync-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--xerxes-border-mid, #0b5966);
      padding-bottom: 6px;
    }
    .sync-modal-title {
      font-size: 10.5px;
      font-weight: bold;
      color: var(--xerxes-cyan, #00f0ff);
      letter-spacing: 1px;
    }
    .sync-modal-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      background: rgba(0, 240, 255, 0.05);
      padding: 8px;
      border: 1px solid var(--xerxes-border-dark, #073840);
      font-size: 8.5px;
    }
    .sync-info-row {
      display: flex;
      justify-content: space-between;
      color: var(--xerxes-text-muted, #729ba6);
    }
    .sync-info-row strong {
      color: var(--xerxes-text-light, #e6f9ff);
    }
    .sync-status-indicator {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
    }
    .sync-status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--xerxes-amber, #ffb000);
      display: inline-block;
    }
    .sync-status-dot.pulse {
      animation: xerxesPulse 1.2s infinite ease-in-out;
    }
    .sync-status-dot.success {
      background: var(--xerxes-mint, #00ff88);
      animation: none;
    }
    .sync-status-dot.error {
      background: var(--xerxes-red, #ff3366);
      animation: none;
    }
    @keyframes xerxesPulse {
      0% { transform: scale(0.9); opacity: 0.5; box-shadow: 0 0 2px var(--xerxes-cyan); }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 10px var(--xerxes-cyan); }
      100% { transform: scale(0.9); opacity: 0.5; box-shadow: 0 0 2px var(--xerxes-cyan); }
    }
    .sync-progress-msg {
      font-size: 9.5px;
      color: var(--xerxes-text-light, #e6f9ff);
      font-family: var(--font-mono);
      flex: 1;
    }
    .sync-progress-container {
      width: 100%;
      height: 14px;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-mid, #0b5966);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }
    .sync-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--xerxes-cyan-dim, #00a4b3), var(--xerxes-cyan, #00f0ff));
      transition: width 0.3s ease;
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
    }
    .sync-modal-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 6px;
      border-top: 1px solid var(--xerxes-border-dark, #073840);
    }
    /* Bringup Workstation Styles */
    .bringup-toolbar {
      background: var(--xerxes-panel);
      border-bottom: 1px solid var(--xerxes-border-mid);
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .bringup-container {
      display: flex;
      flex: 1;
      height: 100%;
      overflow: hidden;
    }
    .bringup-sidebar {
      width: 320px;
      border-right: 1px solid var(--xerxes-border-mid);
      display: flex;
      flex-direction: column;
      background: var(--xerxes-panel);
    }
    .bringup-sidebar-header {
      padding: 6px 10px;
      background: var(--xerxes-header-bg);
      border-bottom: 1px solid var(--xerxes-border-mid);
      font-size: 9px;
      font-weight: bold;
      color: var(--xerxes-cyan);
      letter-spacing: 0.05em;
    }
    .bringup-step-list {
      flex: 1;
      overflow-y: auto;
      list-style: none;
      padding: 4px;
    }
    .bringup-step-item {
      padding: 6px 8px;
      border: 1px solid transparent;
      border-radius: 2px;
      margin-bottom: 3px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 8.5px;
    }
    .bringup-step-item:hover {
      background: var(--xerxes-panel-hover);
      border-color: var(--xerxes-cyan-dim);
    }
    .bringup-step-item.active {
      background: rgba(0, 240, 255, 0.15);
      border-color: var(--xerxes-cyan);
    }
    .bringup-main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: 8px;
      gap: 8px;
    }
    .bringup-card {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      border-radius: 2px;
      padding: 10px;
    }
    .bringup-prompt-card {
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
    }
    .bringup-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6px;
      font-size: 8.5px;
    }
    .bringup-table th, .bringup-table td {
      border: 1px solid var(--xerxes-border-mid);
      padding: 4px 6px;
      text-align: left;
    }
    .bringup-table th {
      background: var(--xerxes-header-bg);
      color: var(--xerxes-cyan);
    }
    .dropzone {
      border: 2px dashed var(--xerxes-border-mid);
      border-radius: 4px;
      padding: 12px;
      text-align: center;
      color: var(--xerxes-text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      background: rgba(0, 240, 255, 0.02);
      font-size: 9px;
    }
    .dropzone:hover, .dropzone.dragover {
      border-color: var(--xerxes-cyan) !important;
      background: rgba(0, 240, 255, 0.08) !important;
      color: var(--xerxes-cyan) !important;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-title">
      <span>⚡ SYSTEM SHOCK 2 // XERXES HOST DAEMON</span>
      <span class="badge" id="targetBadge">{{ runner.target }}</span>
      <span class="badge" id="binBadge">{{ runner.bin_name }}</span>
      <span class="badge badge-green" id="statusBadge">ONLINE</span>
    </div>

    <div style="display: flex; align-items: center; gap: 8px;">
      <button class="btn btn-cyan" id="btnSync" onclick="triggerSync()">⚡ Sync</button>
      <button class="btn btn-amber" id="btnReset" onclick="triggerReset()">⚡ Reset</button>
      <button class="btn btn-red" id="btnTargetBug" onclick="openTargetBugModal()" title="Report defect discovered on target">🐞 Target Bug</button>
      <label for="modeSelect" style="font-size: 8.5px; color: var(--xerxes-text-muted);">ACTIVE MODE:</label>
      <select id="modeSelect" class="select-dropdown" onchange="changeMode(this.value)">
        <option value="CLI" {% if runner.active_mode == 'CLI' %}selected{% endif %}>CLI (RTT Console)</option>
        <option value="FS" {% if runner.active_mode == 'FS' %}selected{% endif %}>FS (Filesystem)</option>
        <option value="BRINGUP" {% if runner.active_mode == 'BRINGUP' %}selected{% endif %}>BRINGUP (Checklist)</option>
      </select>
      <!-- UI Scale Selector (8715cab2) -->
      <label for="uiScaleSelect" style="font-size: 8.5px; color: var(--xerxes-text-muted);">SCALE:</label>
      <select id="uiScaleSelect" class="select-dropdown" onchange="onUiScaleChange(this.value)" title="UI Scale (Shortcuts: Cmd/Ctrl +/- or 0 to reset)" style="padding: 2px 4px; font-size: 8.5px; height: 22px;">
        <option value="75%">75%</option>
        <option value="80%">80%</option>
        <option value="90%">90%</option>
        <option value="100%" selected>100%</option>
        <option value="110%">110%</option>
        <option value="125%">125%</option>
        <option value="150%">150%</option>
      </select>
      <button class="btn" id="btnToggleLog" onclick="toggleLogPanel()">Hide Log</button>
