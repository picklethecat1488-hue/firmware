    // Target Bug Reporting Modal Management (WORM-LOAMY-LUGWORM-536, WORM-BRISTLY-GLOWWORM-390)
    let targetBugAttachments = [];

    function handleTargetBugFileUpload(files) {
      if (!files || !files.length) return;
      Array.from(files).forEach(file => {
        const reader = new FileReader();
        const isImage = file.type.startsWith("image/");
        const isLog = file.name.endsWith(".log") || file.name.endsWith(".txt") || file.type === "text/plain";
        const fileType = isImage ? "screenshot" : (isLog ? "log" : "document");
        reader.onload = (e) => {
          targetBugAttachments.push({
            filename: file.name,
            file_type: fileType,
            content_base64: e.target.result,
            size_bytes: file.size,
            description: `Attached ${fileType} (${file.name})`
          });
          renderTargetBugAttachments();
        };
        reader.readAsDataURL(file);
      });
      const input = document.getElementById("targetBugFileInput");
      if (input) input.value = "";
    }

    async function pasteTargetBugClipboard() {
      try {
        if (navigator.clipboard && navigator.clipboard.read) {
          const items = await navigator.clipboard.read();
          let pasted = false;
          for (const item of items) {
            for (const type of item.types) {
              if (type.startsWith("image/")) {
                const blob = await item.getType(type);
                const reader = new FileReader();
                reader.onload = (e) => {
                  targetBugAttachments.push({
                    filename: `screenshot_${Date.now()}.png`,
                    file_type: "screenshot",
                    content_base64: e.target.result,
                    size_bytes: blob.size,
                    description: "Pasted clipboard screenshot"
                  });
                  renderTargetBugAttachments();
                };
                reader.readAsDataURL(blob);
                pasted = true;
                break;
              }
            }
            if (pasted) break;
          }
          if (pasted) return;
        }
        if (navigator.clipboard && navigator.clipboard.readText) {
          const text = await navigator.clipboard.readText();
          if (text && text.trim()) {
            const b64 = "data:text/plain;base64," + btoa(unescape(encodeURIComponent(text)));
            targetBugAttachments.push({
              filename: `clipboard_${Date.now()}.txt`,
              file_type: "log",
              content_base64: b64,
              content_text: text,
              size_bytes: new Blob([text]).size,
              description: "Pasted clipboard text snippet"
            });
            renderTargetBugAttachments();
          }
        }
      } catch (err) {
        console.warn("Clipboard access error:", err);
      }
    }

    function removeTargetBugAttachment(idx) {
      if (idx >= 0 && idx < targetBugAttachments.length) {
        targetBugAttachments.splice(idx, 1);
        renderTargetBugAttachments();
      }
    }

    function renderTargetBugAttachments() {
      const grid = document.getElementById("targetBugAttachmentsGrid");
      if (!grid) return;
      grid.innerHTML = "";
      targetBugAttachments.forEach((att, idx) => {
        const card = document.createElement("div");
        card.style.background = "#040e14";
        card.style.border = "1px solid var(--xerxes-border-mid)";
        card.style.borderRadius = "3px";
        card.style.padding = "6px";
        card.style.display = "flex";
        card.style.flexDirection = "column";
        card.style.gap = "4px";

        let previewHtml = "";
        if (att.file_type === "screenshot" || (att.content_base64 && att.content_base64.startsWith("data:image/"))) {
          previewHtml = `<img src="${att.content_base64}" style="width:100%; height:65px; object-fit:cover; border-radius:2px; border:1px solid #092430; background:#02070a;" alt="${att.filename}">`;
        } else {
          previewHtml = `<div style="width:100%; height:65px; border-radius:2px; border:1px solid #092430; background:#02070a; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;"><span style="font-size:16px;">📄</span><span style="font-size:7px; color:var(--xerxes-text-muted); font-weight:bold;">${(att.file_type || 'DOCUMENT').toUpperCase()}</span></div>`;
        }

        const sizeKb = ((att.size_bytes || 0) / 1024).toFixed(1);
        card.innerHTML = `
          ${previewHtml}
          <div style="font-size:8.5px; color:#e0f8ff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${att.filename}">${att.filename}</div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:7.5px; color:var(--xerxes-text-dim);">
            <span>${sizeKb} KB</span>
            <button type="button" class="btn" style="font-size:7.5px; padding:1px 4px; color:var(--xerxes-red); border-color:rgba(255,42,75,0.4);" onclick="removeTargetBugAttachment(${idx})">✕</button>
          </div>
        `;
        grid.appendChild(card);
      });
    }

