        <div>
          <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">DESCRIPTION</label>
          <textarea id="targetBugDescription" rows="3" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;" placeholder="Detailed description of defect observed on target..."></textarea>
        </div>

        <div>
          <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">REPRODUCTION STEPS</label>
          <textarea id="targetBugSteps" rows="4" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;"></textarea>
