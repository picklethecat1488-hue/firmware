<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xerxes Host Daemon // {{ runner.package }}:{{ runner.bin_name }}</title>
  <meta name="theme-color" content="#0a1c24">
  <meta name="color-scheme" content="dark">
  <link rel="stylesheet" href="/static/common.css">
  <style>
    html {
      font-size: 80%;
      font-size: calc(80% * var(--ui-scale, 1));
    }
    :root {
      --xerxes-bg: #04090c;
      --xerxes-panel: #08161d;
      --xerxes-panel-hover: #0e242f;
      --xerxes-header-bg: #0a1c24;
      --xerxes-border-light: #00f0ff;
      --xerxes-border-mid: #0b5966;
      --xerxes-border-dark: #021217;
      --xerxes-cyan: #00f0ff;
      --xerxes-cyan-dim: #00a4b3;
      --xerxes-teal: #14d9c4;
      --xerxes-mint: #00ffb4;
      --xerxes-amber: #ffb000;
      --xerxes-red: #ff2a4b;
      --xerxes-green: #00ffb4;
      --xerxes-text-light: #e6f9ff;
      --xerxes-text-muted: #7aa5b0;
      --xerxes-text-dim: #3a626c;
      --font-mono: "Share Tech Mono", ui-monospace, "SF Mono", "Courier New", monospace;
    }
    html {
      height: 100%;
      width: 100%;
    }
    body {
      background-color: var(--xerxes-bg);
      background-image:
        repeating-linear-gradient(0deg, rgba(0,0,0,0.38) 0px, rgba(0,0,0,0.38) 2px, transparent 2px, transparent 4px),
        radial-gradient(ellipse at 50% 0%, #0a2f3a 0%, #03080b 100%);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      height: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    header {
      background: var(--xerxes-header-bg);
      border-bottom: 2px solid var(--xerxes-border-mid);
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .header-title {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--xerxes-cyan);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .badge {
      font-size: 8.5px;
      padding: 2px 6px;
      border-radius: 2px;
      background: rgba(0, 240, 255, 0.15);
      border: 1px solid var(--xerxes-cyan-dim);
      color: var(--xerxes-cyan);
    }
    .badge-cyan {
      background: rgba(0, 240, 255, 0.2);
      border-color: var(--xerxes-cyan);
      color: var(--xerxes-cyan);
    }
    .badge-green {
      background: rgba(0, 255, 180, 0.15);
      border-color: var(--xerxes-green);
      color: var(--xerxes-green);
    }
    .badge-amber {
      background: rgba(255, 176, 0, 0.15);
      border-color: var(--xerxes-amber);
      color: var(--xerxes-amber);
    }
    .test-badge-red {
      background: rgba(255, 42, 75, 0.18);
      border-color: var(--xerxes-red);
      color: var(--xerxes-red);
    }
    .test-mode-container {
      display: flex;
      flex: 1;
      flex-direction: column;
      overflow: hidden;
      gap: 6px;
      padding: 6px 8px;
    }
    .test-table-scroll {
      flex: 1;
      min-height: 150px;
      overflow-y: auto;
      border: 1px solid var(--xerxes-border-mid);
      background: rgba(4, 9, 12, 0.6);
    }
    .test-console-box {
      height: 165px;
      min-height: 110px;
      background: var(--xerxes-bg);
      border: 1px solid var(--xerxes-border-mid);
      border-radius: 2px;
      overflow-y: auto;
      padding: 6px 8px;
      font-size: 9px;
      line-height: 1.4;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .select-dropdown {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-light);
      color: var(--xerxes-cyan);
      font-family: var(--font-mono);
      font-size: 8.5px;
      font-weight: bold;
      padding: 3px 6px;
      border-radius: 2px;
      cursor: pointer;
      outline: none;
    }
    .btn {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      font-size: 8.5px;
      font-weight: bold;
      padding: 3px 8px;
      border-radius: 2px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .btn:hover {
      background: var(--xerxes-panel-hover);
      border-color: var(--xerxes-cyan);
      color: var(--xerxes-cyan);
    }
    .btn-cyan {
      background: rgba(0, 240, 255, 0.2);
      border-color: var(--xerxes-cyan);
      color: var(--xerxes-cyan);
    }
    .btn-amber {
      background: rgba(255, 176, 0, 0.2);
      border-color: var(--xerxes-amber);
      color: var(--xerxes-amber);
    }
    .btn-amber:hover {
      background: rgba(255, 176, 0, 0.35);
      border-color: var(--xerxes-amber);
      color: #fff;
    }
    .btn-red {
      background: rgba(255, 42, 75, 0.2);
      border-color: var(--xerxes-red);
      color: var(--xerxes-red);
    }
    .btn-red:hover {
      background: rgba(255, 42, 75, 0.35);
      border-color: var(--xerxes-red);
      color: #fff;
    }
    .btn-copy {
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid var(--xerxes-cyan);
      color: var(--xerxes-cyan);
      padding: 1px 6px;
      font-size: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      border-radius: 2px;
      outline: none;
    }
    .btn-copy:hover {
      background: rgba(0, 240, 255, 0.25);
      color: #ffffff;
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.4);
    }
    .workspace-body {
      flex: 1;
      display: flex;
      flex-direction: row;
      gap: 0;
      padding: 8px;
      overflow: hidden;
      position: relative;
    }
    .log-panel {
      width: 50%;
      min-width: 0px;
      flex-shrink: 0;
    }
    .cli-panel {
      flex: 1;
      min-width: 200px;
    }
    .vertical-splitter {
      width: 10px;
      cursor: col-resize;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      user-select: none;
      flex-shrink: 0;
      margin: 0 4px;
      transition: background 0.15s ease;
      z-index: 10;
    }
    .vertical-splitter:hover, .vertical-splitter.dragging {
      background: rgba(0, 240, 255, 0.2);
    }
    .splitter-gripper {
      width: 2px;
      height: 40px;
      background: var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.6);
      border-radius: 1px;
      opacity: 0.6;
      transition: opacity 0.2s, height 0.2s;
    }
    .vertical-splitter:hover .splitter-gripper, .vertical-splitter.dragging .splitter-gripper {
      opacity: 1;
      height: 60px;
    }
    .panel-container {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      box-shadow: inset 1px 1px 0px rgba(0, 240, 255, 0.25), inset -1px -1px 0px var(--xerxes-border-dark);
      border-radius: 3px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .panel-header {
      background: rgba(10, 28, 36, 0.85);
      border-bottom: 1px solid var(--xerxes-border-mid);
      padding: 5px 10px;
      font-size: 9px;
      font-weight: bold;
      color: var(--xerxes-cyan);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .panel-content {
      display: block;
      flex: 1;
      flex-direction: column;
      overflow-y: auto;
      padding: 6px 8px;
      font-size: 9.5px;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .log-line {
      margin-bottom: 2px;
    }
    .log-line-error { color: var(--xerxes-red); }
    .log-line-warn { color: var(--xerxes-amber); }
    .log-line-info { color: var(--xerxes-text-light); }
    .log-line-target { color: var(--xerxes-mint); }
    .cli-line-input { color: var(--xerxes-cyan); font-weight: bold; cursor: pointer; }
    .cli-line-input:hover { text-decoration: underline; }
    .cli-line-output { color: var(--xerxes-text-light); }
    .fs-toolbar {
      padding: 4px 8px;
      border-bottom: 1px solid var(--xerxes-border-dark);
      display: flex;
      gap: 6px;
      background: rgba(0, 240, 255, 0.05);
      align-items: center;
      flex-wrap: wrap;
    }
    footer.cli-input-bar {
      background: var(--xerxes-header-bg);
      border-top: 2px solid var(--xerxes-border-mid);
      padding: 6px 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      position: relative;
    }
    .prompt-label {
      color: var(--xerxes-cyan);
      font-weight: bold;
      font-size: 9.5px;
      white-space: nowrap;
      cursor: pointer;
    }
    .cmd-input {
      flex: 1;
      background: var(--xerxes-bg);
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      font-size: 9.5px;
      padding: 4px 8px;
      outline: none;
      border-radius: 2px;
    }
    .cmd-input:focus {
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 6px rgba(0, 240, 255, 0.4);
    }

    /* CLI Fuzzy History Search (Ctrl-R) */
    .cli-fuzzy-history {
      position: absolute;
      bottom: 48px;
      left: 0;
      right: 0;
      max-height: 220px;
      background: var(--xerxes-panel, #08161d);
      border: 2px solid var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.9), 0 0 10px rgba(0, 240, 255, 0.2);
      z-index: 2500;
      display: flex;
      flex-direction: column;
    }
    .fuzzy-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 8px;
      background: rgba(10, 28, 36, 0.95);
      border-bottom: 1px solid var(--xerxes-border-mid, #0b5966);
    }
    .fuzzy-prompt {
      color: var(--xerxes-amber, #ffb000);
      font-weight: bold;
      font-size: 8.5px;
      white-space: nowrap;
    }
    .fuzzy-search-input {
      flex: 1;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-mid, #0b5966);
      color: var(--xerxes-text-light, #e6f9ff);
      font-family: var(--font-mono);
      font-size: 8.5px;
      padding: 3px 6px;
      outline: none;
    }
    .fuzzy-results-list {
      overflow-y: auto;
      max-height: 170px;
    }
    .fuzzy-item {
      padding: 4px 10px;
      font-size: 8.5px;
      font-family: var(--font-mono);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid rgba(11, 89, 102, 0.3);
      color: var(--xerxes-text-light, #e6f9ff);
    }
    .fuzzy-item:hover, .fuzzy-item.active {
      background: rgba(0, 240, 255, 0.2);
      color: var(--xerxes-cyan, #00f0ff);
      font-weight: bold;
    }

    /* Terminal Formatting & Coloration (VS Code Terminal Aesthetic) */
    .term-bold, .ansi-bold { font-weight: bold; }
    .term-dim, .ansi-dim { opacity: 0.7; }
    .term-italic, .ansi-italic { font-style: italic; }
    .term-underline, .ansi-underline { text-decoration: underline; }
    .term-fg-black, .ansi-fg-black { color: #5c6370; }
    .term-fg-red, .ansi-fg-red { color: #e06c75; }
    .term-fg-green, .ansi-fg-green { color: #98c379; }
    .term-fg-yellow, .ansi-fg-yellow { color: #e5c07b; }
    .term-fg-blue, .ansi-fg-blue { color: #61afef; }
    .term-fg-magenta, .ansi-fg-magenta { color: #c678dd; }
    .term-fg-cyan, .ansi-fg-cyan { color: #56b6c2; }
    .term-fg-white, .ansi-fg-white { color: #dcdfe4; }
    .term-fg-bright-black, .ansi-fg-bright-black { color: #7f848e; }
    .term-fg-bright-red, .ansi-fg-bright-red { color: #ff6b68; }
    .term-fg-bright-green, .ansi-fg-bright-green { color: #a8cc8c; }
    .term-fg-bright-yellow, .ansi-fg-bright-yellow { color: #e5c07b; }
    .term-fg-bright-blue, .ansi-fg-bright-blue { color: #73b8ff; }
    .term-fg-bright-magenta, .ansi-fg-bright-magenta { color: #d68ff0; }
    .term-fg-bright-cyan, .ansi-fg-bright-cyan { color: #00f0ff; }
    .term-fg-bright-white, .ansi-fg-bright-white { color: #ffffff; }
    .term-bg-black, .ansi-bg-black { background-color: #282c34; }
    .term-bg-red, .ansi-bg-red { background-color: #e06c75; }
    .term-bg-green, .ansi-bg-green { background-color: #98c379; }
    .term-bg-yellow, .ansi-bg-yellow { background-color: #e5c07b; }
    .term-bg-blue, .ansi-bg-blue { background-color: #61afef; }
    .term-bg-magenta, .ansi-bg-magenta { background-color: #c678dd; }
    .term-bg-cyan, .ansi-bg-cyan { background-color: #56b6c2; }
    .term-bg-white, .ansi-bg-white { background-color: #dcdfe4; }
    .term-link, .osc8-link {
      color: var(--xerxes-cyan, #00f0ff);
      text-decoration: underline;
      cursor: pointer;
    }
    .osc8-cmd-btn {
      background: transparent;
      border: none;
      padding: 0;
      margin: 0;
      font: inherit;
      display: inline;
    }
    .term-link:hover, .osc8-link:hover {
      color: #ffffff;
      text-shadow: 0 0 6px var(--xerxes-cyan, #00f0ff);
    }

    /* Modal Flashing Status Window & Progress Bar */
    .sync-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(4, 9, 12, 0.85);
      backdrop-filter: blur(4px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sync-modal-box {
      width: 780px;
      max-width: 95vw;
      max-height: 88vh;
      background: var(--xerxes-panel, #08161d);
      border: 2px solid var(--xerxes-cyan, #00f0ff);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.3), inset 0 0 15px rgba(0, 240, 255, 0.1);
      display: flex;
      flex-direction: column;
      padding: 16px;
      gap: 12px;
      border-radius: 4px;
    }
    .sync-console-container {
      width: 100%;
      height: 280px;
      max-height: 42vh;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-dark, #073840);
      border-radius: 2px;
      overflow-y: auto;
      font-family: var(--font-mono);
      font-size: 9px;
      line-height: 1.4;
      padding: 6px 8px;
      color: var(--xerxes-text-light, #e6f9ff);
      box-sizing: border-box;
      white-space: pre-wrap;
      word-break: break-all;
    }
    .sync-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--xerxes-border-mid, #0b5966);
      padding-bottom: 6px;
    }
    .sync-modal-title {
      font-size: 10.5px;
      font-weight: bold;
      color: var(--xerxes-cyan, #00f0ff);
      letter-spacing: 1px;
    }
    .sync-modal-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      background: rgba(0, 240, 255, 0.05);
      padding: 8px;
      border: 1px solid var(--xerxes-border-dark, #073840);
      font-size: 8.5px;
    }
    .sync-info-row {
      display: flex;
      justify-content: space-between;
      color: var(--xerxes-text-muted, #729ba6);
    }
    .sync-info-row strong {
      color: var(--xerxes-text-light, #e6f9ff);
    }
    .sync-status-indicator {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
    }
    .sync-status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--xerxes-amber, #ffb000);
      display: inline-block;
    }
    .sync-status-dot.pulse {
      animation: xerxesPulse 1.2s infinite ease-in-out;
    }
    .sync-status-dot.success {
      background: var(--xerxes-mint, #00ff88);
      animation: none;
    }
    .sync-status-dot.error {
      background: var(--xerxes-red, #ff3366);
      animation: none;
    }
    @keyframes xerxesPulse {
      0% { transform: scale(0.9); opacity: 0.5; box-shadow: 0 0 2px var(--xerxes-cyan); }
      50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 10px var(--xerxes-cyan); }
      100% { transform: scale(0.9); opacity: 0.5; box-shadow: 0 0 2px var(--xerxes-cyan); }
    }
    .sync-progress-msg {
      font-size: 9.5px;
      color: var(--xerxes-text-light, #e6f9ff);
      font-family: var(--font-mono);
      flex: 1;
    }
    .sync-progress-container {
      width: 100%;
      height: 14px;
      background: var(--xerxes-bg, #04090c);
      border: 1px solid var(--xerxes-border-mid, #0b5966);
      border-radius: 2px;
      overflow: hidden;
      position: relative;
    }
    .sync-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--xerxes-cyan-dim, #00a4b3), var(--xerxes-cyan, #00f0ff));
      transition: width 0.3s ease;
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
    }
    .sync-modal-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 6px;
      border-top: 1px solid var(--xerxes-border-dark, #073840);
    }
    /* Bringup Workstation Styles */
    .bringup-toolbar {
      background: var(--xerxes-panel);
      border-bottom: 1px solid var(--xerxes-border-mid);
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .bringup-container {
      display: flex;
      flex: 1;
      height: 100%;
      overflow: hidden;
    }
    .bringup-sidebar {
      width: 320px;
      border-right: 1px solid var(--xerxes-border-mid);
      display: flex;
      flex-direction: column;
      background: var(--xerxes-panel);
    }
    .bringup-sidebar-header {
      padding: 6px 10px;
      background: var(--xerxes-header-bg);
      border-bottom: 1px solid var(--xerxes-border-mid);
      font-size: 9px;
      font-weight: bold;
      color: var(--xerxes-cyan);
      letter-spacing: 0.05em;
    }
    .bringup-step-list {
      flex: 1;
      overflow-y: auto;
      list-style: none;
      padding: 4px;
    }
    .bringup-step-item {
      padding: 6px 8px;
      border: 1px solid transparent;
      border-radius: 2px;
      margin-bottom: 3px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 8.5px;
    }
    .bringup-step-item:hover {
      background: var(--xerxes-panel-hover);
      border-color: var(--xerxes-cyan-dim);
    }
    .bringup-step-item.active {
      background: rgba(0, 240, 255, 0.15);
      border-color: var(--xerxes-cyan);
    }
    .bringup-main-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: 8px;
      gap: 8px;
    }
    .bringup-card {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      border-radius: 2px;
      padding: 10px;
    }
    .bringup-prompt-card {
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
    }
    .bringup-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6px;
      font-size: 8.5px;
    }
    .bringup-table th, .bringup-table td {
      border: 1px solid var(--xerxes-border-mid);
      padding: 4px 6px;
      text-align: left;
    }
    .bringup-table th {
      background: var(--xerxes-header-bg);
      color: var(--xerxes-cyan);
    }
    .dropzone {
      border: 2px dashed var(--xerxes-border-mid);
      border-radius: 4px;
      padding: 12px;
      text-align: center;
      color: var(--xerxes-text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      background: rgba(0, 240, 255, 0.02);
      font-size: 9px;
    }
    .dropzone:hover, .dropzone.dragover {
      border-color: var(--xerxes-cyan) !important;
      background: rgba(0, 240, 255, 0.08) !important;
      color: var(--xerxes-cyan) !important;
    }
  </style>
</head>
<body>
  <header>
    <div class="header-title">
      <span>⚡ SYSTEM SHOCK 2 // XERXES HOST DAEMON</span>
      <span class="badge" id="targetBadge">{{ runner.target }}</span>
      <span class="badge" id="binBadge">{{ runner.bin_name }}</span>
      <span class="badge badge-green" id="statusBadge">ONLINE</span>
    </div>

    <div style="display: flex; align-items: center; gap: 8px;">
      <button class="btn btn-cyan" id="btnSync">⚡ Sync</button>
      <button class="btn btn-amber" id="btnReset">⚡ Reset</button>
      <button class="btn btn-cyan" id="btnTargetConfig" title="Target Application Configuration">🎯 Target Config</button>
      <button class="btn btn-red" id="btnTargetBug" title="Report defect discovered on target">🐞 Target Bug</button>
      <label for="modeSelect" style="font-size: 8.5px; color: var(--xerxes-text-muted);">ACTIVE MODE:</label>
      <select id="modeSelect" class="select-dropdown">
        <option value="CLI" {% if runner.active_mode == 'CLI' %}selected{% endif %}>CLI (RTT Console)</option>
        <option value="FS" {% if runner.active_mode == 'FS' %}selected{% endif %}>FS (Filesystem)</option>
        <option value="TEST" {% if runner.active_mode == 'TEST' %}selected{% endif %}>TEST (Device Suites)</option>
      </select>
      <label for="uiScaleSelect" style="font-size: 8.5px; color: var(--xerxes-text-muted);">SCALE:</label>
      <select id="uiScaleSelect" class="select-dropdown" title="UI Scale (Shortcuts: Cmd/Ctrl +/- or 0 to reset)" style="padding: 2px 4px; font-size: 8.5px; height: 22px;">
        <option value="75%">75%</option>
        <option value="80%">80%</option>
        <option value="90%">90%</option>
        <option value="100%" selected>100%</option>
        <option value="110%">110%</option>
        <option value="125%">125%</option>
        <option value="150%">150%</option>
      </select>
      <button class="btn btn-amber" id="btnToggleLog">Show Log</button>
      <button class="btn" id="btnClearOutput">Clear</button>
    </div>
  </header>

  <!-- Target Flashing & Synchronization Modal (Xerxes Theme) -->
  <div id="syncModal" class="sync-modal-backdrop" style="display:none;">
    <div class="sync-modal-box">
      <div class="sync-modal-header">
        <span class="sync-modal-title">⚡ TARGET SYNC & FLASH MATRIX</span>
        <button class="btn" id="btnCloseSyncModal" style="padding: 2px 6px; font-size: 8.5px;">✕</button>
      </div>
      <div class="sync-modal-info">
        <div class="sync-info-row"><span>Target:</span><strong id="syncInfoTarget">{{ runner.target }}</strong></div>
        <div class="sync-info-row"><span>Package:</span><strong id="syncInfoPackage">{{ runner.package }} ({{ runner.bin_name }})</strong></div>
        <div class="sync-info-row"><span>Profile:</span><strong id="syncInfoProfile">{{ 'release' if runner.release else 'debug' }}</strong></div>
        <div class="sync-info-row"><span>Speed:</span><strong id="syncInfoSpeed">{{ runner.speed }} kHz</strong></div>
      </div>
      <div class="sync-status-indicator">
        <span class="sync-status-dot pulse" id="syncStatusDot"></span>
        <span id="syncProgressMsg" class="sync-progress-msg">Synchronizing target firmware...</span>
      </div>
      <div class="sync-progress-container">
        <div class="sync-progress-bar" id="syncProgressBar" style="width: 0%;"></div>
      </div>
      <div class="sync-console-container" id="syncConsoleLog"></div>
      <div class="sync-modal-footer">
        <span id="syncProgressPct" style="font-size: 9px; color: var(--xerxes-cyan);">0%</span>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-amber" id="btnSyncCancel">Cancel</button>
          <button class="btn" id="btnSyncDismiss">Dismiss</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Target Bug Reporting Modal (WORM-LOAMY-LUGWORM-536) -->
  <div id="targetBugModal" class="sync-modal-backdrop" style="display:none;">
    <div class="sync-modal-box" style="max-width: 680px; width: 92%;">
      <div class="sync-modal-header" style="border-bottom: 2px solid var(--xerxes-red);">
        <span class="sync-modal-title" style="color: var(--xerxes-red);">🐞 TARGET DEFECT DISCOVERY // REPORT WORM</span>
        <button class="btn" id="btnCloseTargetBugModal" style="padding: 2px 6px; font-size: 8.5px;">✕</button>
      </div>
      <div style="display:flex; flex-direction:column; gap:10px; padding:14px; max-height:75vh; overflow-y:auto;">
        <div style="display:flex; gap:10px;">
          <div style="flex:2;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">BUG TITLE *</label>
            <input type="text" id="targetBugTitle" class="quake-input" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:11px; background:#040d12; border:1px solid #0b5966; color:#00f0ff;" placeholder="Brief summary of defect (e.g. Motor fails to spin on speed 100)...">
          </div>
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">SEVERITY</label>
            <select id="targetBugSeverity" class="select-dropdown" style="width:100%; height:28px;">
              <option value="CRITICAL">🔴 CRITICAL</option>
              <option value="HIGH">🟠 HIGH</option>
              <option value="MEDIUM" selected>🟡 MEDIUM</option>
              <option value="LOW">🟢 LOW</option>
            </select>
          </div>
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">CATEGORY</label>
            <select id="targetBugCategory" class="select-dropdown" style="width:100%; height:28px;">
              <option value="FIRMWARE" selected>FIRMWARE</option>
              <option value="CONTROLLER">CONTROLLER</option>
              <option value="DRIVER">DRIVER</option>
              <option value="PLATFORM">PLATFORM</option>
              <option value="BOARD">BOARD</option>
              <option value="SHELL">SHELL</option>
              <option value="INFRASTRUCTURE">INFRASTRUCTURE</option>
            </select>
          </div>
        </div>

        <div style="display:flex; gap:10px;">
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">COMPONENT</label>
            <input type="text" id="targetBugComponent" class="quake-input" style="width:100%; box-sizing:border-box; padding:5px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff;" value="target">
          </div>
          <div style="flex:2;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">TARGET DETAILS</label>
            <div style="font-size:9px; color:var(--xerxes-text-dim); padding-top:4px;">
              Target: <strong>{{ runner.target }}</strong> | Binary: <strong>{{ runner.bin_name }}</strong> ({{ 'release' if runner.release else 'debug' }})
            </div>
          </div>
        </div>

        <div>
          <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">DESCRIPTION</label>
          <textarea id="targetBugDescription" rows="3" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;" placeholder="Detailed description of defect observed on target..."></textarea>
        </div>

        <div>
          <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">REPRODUCTION STEPS</label>
          <textarea id="targetBugSteps" rows="4" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;"></textarea>
        </div>

        <div style="display:flex; gap:10px;">
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">EXPECTED BEHAVIOR</label>
            <textarea id="targetBugExpected" rows="2" style="width:100%; box-sizing:border-box; padding:5px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;"></textarea>
          </div>
          <div style="flex:1;">
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:3px;">ACTUAL BEHAVIOR</label>
            <textarea id="targetBugActual" rows="2" style="width:100%; box-sizing:border-box; padding:5px 8px; font-size:10px; background:#040d12; border:1px solid #0b5966; color:#e0f8ff; font-family:monospace; resize:vertical;"></textarea>
          </div>
        </div>

        <!-- Target Attachment Options -->
        <div style="background:rgba(0,240,255,0.03); border:1px solid #0b5966; border-radius:3px; padding:10px;">
          <span style="font-size:9px; font-weight:bold; color:var(--xerxes-cyan); display:block; margin-bottom:8px;">AUTOMATIC TARGET ATTACHMENTS</span>
          <div style="display:flex; flex-direction:column; gap:6px; font-size:9px;">
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
              <input type="checkbox" id="attachSystemLogs" checked>
              <span>Attach recent system logs (defmt / RTT output from session)</span>
            </label>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
              <input type="checkbox" id="attachCrashLog">
              <span>Fetch &amp; attach target crash log (host_fs crash-log)</span>
            </label>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
              <input type="checkbox" id="attachTelemetry">
              <span>Fetch &amp; attach target telemetry (host_fs export-telemetry)</span>
            </label>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
              <input type="checkbox" id="attachMetadata">
              <span>Fetch &amp; attach target filesystem metadata (host_fs cat metadata)</span>
            </label>
          </div>
        </div>

        <!-- Attachments & Screenshots Section (WORM-BRISTLY-GLOWWORM-390) -->
        <div style="background:rgba(0,240,255,0.03); border:1px solid #0b5966; border-radius:3px; padding:10px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span style="font-size:9px; font-weight:bold; color:var(--xerxes-cyan); text-transform:uppercase;">Attachments &amp; Screenshots</span>
            <button type="button" class="btn" id="btnPasteTargetBugClipboard" style="font-size:8px; padding:2px 6px;">📋 Paste Clipboard</button>
          </div>
          <div id="targetBugDropzone" class="dropzone">
            <div>📥 Drag &amp; Drop Screenshots, Logs, or Documents Here (or click to browse)</div>
            <div style="font-size:8.5px; margin-top:3px; color:var(--xerxes-text-dim);">Press ⌘V / Ctrl+V to paste screenshots or text</div>
            <div style="font-size:7.5px; margin-top:4px; color:var(--xerxes-text-dim);">Attachments are tracked in GitHub LFS and considered non-confidential.</div>
          </div>
          <input type="file" id="targetBugFileInput" style="display:none;" multiple>
          <div id="targetBugAttachmentsGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); gap:8px; margin-top:8px;"></div>
        </div>

        <div id="targetBugProgressContainer" style="display:none; margin-top:4px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
            <span id="targetBugProgressMsg" style="font-size:9px; color:var(--xerxes-cyan);">Initializing defect report...</span>
            <span id="targetBugProgressPct" style="font-size:9px; color:var(--xerxes-cyan); font-weight:bold;">0%</span>
          </div>
          <div class="sync-progress-container" style="height:6px; background:#021217; border:1px solid #0b5966; border-radius:2px; overflow:hidden;">
            <div id="targetBugProgressBar" class="sync-progress-bar" style="width:0%; height:100%; background:linear-gradient(90deg, var(--xerxes-teal), var(--xerxes-cyan)); transition:width 0.25s ease;"></div>
          </div>
        </div>

        <div id="targetBugStatusMsg" style="display:none; font-size:9.5px; padding:6px 10px; border-radius:2px;"></div>
      </div>
      <div class="sync-modal-footer" style="padding:10px 14px; border-top:1px solid #0b5966; display:flex; justify-content:flex-end; gap:8px;">
        <button class="btn" id="btnCancelTargetBug">Cancel</button>
        <button class="btn btn-red" id="btnSubmitTargetBug">⚡ File Target Bug</button>
      </div>
    </div>
  </div>

  <!-- Target Application Configuration Modal (WORM-SLIMY-PLANARIAN-761) -->
  <div id="targetConfigModal" class="sync-modal-backdrop" style="display:none;">
    <div class="sync-modal-box" style="max-width: 580px; width: 92%;">
      <div class="sync-modal-header" style="border-bottom: 2px solid var(--xerxes-cyan);">
        <span class="sync-modal-title" style="color: var(--xerxes-cyan);">⚡ TARGET CONFIGURATION // PACKAGE SELECTION MATRIX</span>
        <button class="btn" id="btnCloseTargetConfigModal" style="padding: 2px 6px; font-size: 8.5px;">✕</button>
      </div>
      <div style="display:flex; flex-direction:column; gap:12px; padding:16px;">
        <div style="font-size: 9.5px; color: var(--xerxes-text-dim); line-height: 1.4;">
          Configure target application package, binary artifact, build profile, and probe parameters. Target ARM architecture is automatically inferred based on MCU hardware mappings.
        </div>

        <!-- Package & Binary selection -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div>
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:4px; font-weight:bold;">TARGET PACKAGE *</label>
            <select id="cfgPackageSelect" class="quake-input" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:11px; background:#040d12; border:1px solid #0b5966; color:#00f0ff;">
              {% if target_packages %}
                {% for pkg in target_packages %}
                  <option value="{{ pkg.package }}" {% if pkg.package == runner.package %}selected{% endif %}>{{ pkg.package }}</option>
                {% endfor %}
              {% else %}
                <option value="{{ runner.package }}" selected>{{ runner.package }}</option>
              {% endif %}
            </select>
          </div>
          <div>
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:4px; font-weight:bold;">TARGET BINARY *</label>
            <select id="cfgBinSelect" class="quake-input" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:11px; background:#040d12; border:1px solid #0b5966; color:#00f0ff;">
              <option value="{{ runner.bin_name }}" selected>{{ runner.bin_name }}</option>
            </select>
          </div>
        </div>

        <!-- Build Profile & Speed -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items:center;">
          <div>
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:4px; font-weight:bold;">BUILD PROFILE</label>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:10px; color:var(--xerxes-text-bright); margin-top:4px;">
              <input type="checkbox" id="cfgReleaseCheckbox" {% if runner.release %}checked{% endif %} style="accent-color:var(--xerxes-cyan); cursor:pointer;">
              <span>Release (--release, opt-level=z, LTO)</span>
            </label>
          </div>
          <div>
            <label style="font-size:8.5px; color:var(--xerxes-text-muted); display:block; margin-bottom:4px; font-weight:bold;">PROBE PROTOCOL SPEED</label>
            <select id="cfgSpeedSelect" class="quake-input" style="width:100%; box-sizing:border-box; padding:6px 8px; font-size:11px; background:#040d12; border:1px solid #0b5966; color:#00f0ff;">
              <option value="4000" {% if runner.speed == 4000 %}selected{% endif %}>4000 kHz (High Speed)</option>
              <option value="1000" {% if runner.speed == 1000 %}selected{% endif %}>1000 kHz (Default)</option>
              <option value="500" {% if runner.speed == 500 %}selected{% endif %}>500 kHz (Safe)</option>
            </select>
          </div>
        </div>

        <!-- Inferred Target Architecture Display -->
        <div style="background:#05141c; border:1px solid #0b5966; padding:8px 12px; border-radius:3px; display:flex; flex-direction:column; gap:4px;">
          <span style="font-size:8.5px; color:var(--xerxes-text-muted); font-weight:bold;">INFERRED ARM ARCHITECTURE</span>
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <span id="cfgInferredArchDisplay" style="color:var(--xerxes-cyan); font-weight:bold; font-family:var(--font-mono); font-size:11px;">{{ runner.target }}</span>
            <span id="cfgInferredArchNote" style="color:var(--xerxes-text-dim); font-size:9px;">(Auto-inferred from board definition)</span>
          </div>
          <input type="hidden" id="cfgTargetArchInput" value="{{ runner.target }}">
        </div>

        <!-- Logging Preference -->
        <div style="background:#05141c; border:1px solid #0b5966; padding:8px 12px; border-radius:3px; display:flex; flex-direction:column; gap:4px;">
          <span style="font-size:8.5px; color:var(--xerxes-text-muted); font-weight:bold;">LOGGING PREFERENCE</span>
          <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:10px; color:var(--xerxes-text-bright); margin-top:2px;">
            <input type="checkbox" id="cfgShowLogsCheckbox" {% if runner.show_system_logs | default(false) %}checked{% endif %} style="accent-color:var(--xerxes-cyan); cursor:pointer;">
            <span>Show system logs on startup (defmt / RTT monitor)</span>
          </label>
        </div>

        <div id="cfgStatusMsg" style="display:none; font-size:9.5px; padding:6px 10px; border-radius:2px;"></div>
      </div>
      <div class="sync-modal-footer" style="padding:10px 14px; border-top:1px solid #0b5966; display:flex; justify-content:flex-end; gap:8px;">
        <button class="btn" id="btnCancelTargetConfig">DISMISS</button>
        <button class="btn btn-primary" id="btnConfirmTargetConfig">⚡ FLASH &amp; CONNECT</button>
      </div>
    </div>
  </div>

  <main class="workspace-body">
    <!-- Left Panel: System / Target Logging -->
    <div class="panel-container log-panel" id="logPanel" style="display: none;">
      <div class="panel-header">
        <span>SYSTEM LOGGING MONITOR (defmt / RTT)</span>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button class="btn btn-copy" id="btnCopyLog" title="Copy log output">📋 Copy</button>
          <button class="btn btn-copy" id="btnCollapseLog" title="Show logging monitor">▶ Show</button>
          <span id="logAutoScrollBadge" style="font-size: 8px; color: var(--xerxes-text-dim); cursor: pointer;">AUTO-SCROLL: ON</span>
        </div>
      </div>
      <div class="panel-content" id="logView">
        <div class="log-line log-line-info">&gt; Host daemon online. Attached to {{ runner.package }}.</div>
      </div>
    </div>

    <!-- Draggable Vertical Splitter with Gripper -->
    <div class="vertical-splitter" id="vSplitter" title="Drag to resize panels" style="display: none;">
      <div class="splitter-gripper"></div>
    </div>

    <!-- Right Panel: Interactive CLI & FS View -->
    <div class="panel-container cli-panel" id="cliPanel">
      <div class="panel-header">
        <span id="cliPanelTitle">INTERACTIVE CLI CONSOLE</span>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button class="btn btn-copy" id="btnCopyWorkstation" title="Copy workstation output">📋 Copy</button>
          <span style="font-size: 8px; color: var(--xerxes-text-muted);" id="channelBadge">CHANNEL: BOTH</span>
        </div>
      </div>

      <!-- Optional FS Action Toolbar -->
      <div id="fsToolbar" class="fs-toolbar" style="display: {% if runner.active_mode == 'FS' %}flex{% else %}none{% endif %};">
        <span style="font-size: 8.5px; color: var(--xerxes-text-muted); margin-right: 4px;">Quick Actions:</span>
        <button class="btn btn-cyan" data-fs-cmd="ls">ls</button>
        <button class="btn" data-fs-cmd="crash-log">crash-log</button>
        <button class="btn" data-fs-cmd="cat metadata">cat metadata</button>
        <button class="btn" data-fs-cmd="export-telemetry">export-telemetry</button>
        <button class="btn" data-fs-cmd="format">format</button>
      </div>

      <!-- Active Manual Test Prompt Banner (populated from pytest /api/manual_prompt heartbeats) -->
      <div id="manualPromptBanner" class="bringup-toolbar" style="display: none; border-color: var(--xerxes-amber); gap: 8px; cursor: pointer;">
        <span class="badge badge-amber">MANUAL TEST</span>
        <span id="manualPromptSummary" style="font-size: 8.5px; color: var(--xerxes-text-light);"></span>
      </div>

      <div class="panel-content" id="cliView" style="display: {% if runner.active_mode in ('FS', 'TEST') %}none{% else %}block{% endif %};">
        <div class="log-line log-line-info">&gt; Interactive CLI workstation ready. Type commands below.</div>
      </div>

      <div class="panel-content" id="fsView" style="display: {% if runner.active_mode == 'FS' %}block{% else %}none{% endif %};">
        <div class="log-line log-line-info">&gt; Filesystem (host_fs) workstation ready. Type FS commands below (e.g. 'ls', 'cat metadata', 'format').</div>
      </div>

      <!-- On-Device Test Runner Mode (supersedes legacy bringup workstation) -->
      <div id="testView" class="test-mode-container" style="display: {% if runner.active_mode == 'TEST' %}flex{% else %}none{% endif %};">
        <div class="bringup-toolbar" style="padding: 6px 8px; border: 1px solid var(--xerxes-border-mid); border-radius: 2px; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            <button type="button" class="btn btn-cyan" id="btnTestScan">🔄 Scan</button>
            <select id="testFilterProject" class="select-dropdown" title="Filter by @device_test(project=...)">
              <option value="all" selected>All Projects</option>
            </select>
            <select id="testFilterScenario" class="select-dropdown" title="Filter by @device_test(scenarios=...)">
              <option value="all" selected>All Scenarios</option>
              <option value="default">Smoke + Integration</option>
              <option value="smoke">Smoke</option>
              <option value="integration">Integration</option>
              <option value="bringup">Bringup</option>
            </select>
            <input type="text" id="testFilterBoard" class="cmd-input" value="*" placeholder="Board glob (*, auto, rp2040*)" style="width: 130px; flex: none; padding: 3px 6px; font-size: 8.5px;" title="Filter by board_type glob pattern or 'auto'">
            <select id="testFilterBinary" class="select-dropdown" title="Filter by @device_test(target_binary=...)">
              <option value="all" selected>All Binaries</option>
            </select>
            <select id="testFilterManual" class="select-dropdown" title="Filter by manual vs automated tests">
              <option value="all" selected>All Modes</option>
              <option value="automated">Automated Only</option>
              <option value="manual">Manual Only</option>
            </select>
            <input type="text" id="testFilterSearch" class="cmd-input" placeholder="Filter name / description..." style="width: 155px; flex: none; padding: 3px 6px; font-size: 8.5px;">
          </div>
          <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            <span id="testDetectedBoardBadge" class="badge badge-amber">BOARD: NOT SCANNED</span>
            <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 8.5px; color: var(--xerxes-text-muted); cursor: pointer;">
              <input type="checkbox" id="testEnableManualCb" checked>
              <span>Prompt Manual</span>
            </label>
            <button type="button" class="btn btn-cyan" id="btnTestRunSelected">▶ Run Selected (0)</button>
            <button type="button" class="btn btn-cyan" id="btnTestRunFiltered">▶ Run Filtered (0)</button>
            <button type="button" class="btn btn-red" id="btnTestCancel" disabled>⏹ Stop</button>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 8.5px; color: var(--xerxes-text-muted); padding: 0 2px;">
          <span id="testSummaryStats">0 Shown | 0 Selected | 0 Passed • 0 Failed • 0 Skipped [IDLE]</span>
          <span>Top-to-bottom deterministic suite order</span>
        </div>

        <!-- Interactive Manual Operator Prompt Card (YES/NO, Measured Value, Cancel with Comment) -->
        <div id="testManualPromptCard" class="bringup-card bringup-prompt-card" style="display: none; flex-direction: column; gap: 8px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span class="badge badge-amber">⚡ MANUAL BENCHTOP PROMPT</span>
            <strong id="testManualTitle" style="font-size: 9.5px; color: var(--xerxes-cyan);"></strong>
          </div>
          <div style="font-size: 9px; color: var(--xerxes-text-muted);">
            <strong>Procedure:</strong> <span id="testManualProcedure" style="color: var(--xerxes-text-light);"></span>
          </div>
          <div style="font-size: 9.5px; color: var(--xerxes-amber); font-weight: bold;">
            <span>Prompt:</span> <span id="testManualPromptText" style="color: var(--xerxes-text-light);"></span>
          </div>

          <div id="testManualYesNoRow" style="display: flex; align-items: center; gap: 8px;">
            <button type="button" class="btn btn-cyan" id="btnManualYes">✓ YES</button>
            <button type="button" class="btn btn-red" id="btnManualNo">✕ NO</button>
          </div>

          <div id="testManualMeasurementRow" style="display: none; align-items: center; gap: 8px;">
            <label for="testManualValueInput" style="font-size: 8.5px; color: var(--xerxes-text-muted);">MEASURED VALUE:</label>
            <input type="text" id="testManualValueInput" class="cmd-input" placeholder="e.g. 5.01" style="max-width: 150px; flex: none;">
            <span id="testManualUnitLabel" style="font-size: 9px; color: var(--xerxes-cyan); font-weight: bold;"></span>
            <button type="button" class="btn btn-cyan" id="btnManualSubmitValue">Submit Measurement</button>
          </div>

          <div style="display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--xerxes-border-dark); padding-top: 6px;">
            <input type="text" id="testManualCommentInput" class="cmd-input" placeholder="Required comment to cancel this manual test..." style="font-size: 8.5px;">
            <button type="button" class="btn btn-amber" id="btnManualCancel">Cancel Test</button>
          </div>
          <div id="testManualErrorMsg" style="display: none; font-size: 8.5px; color: var(--xerxes-red);"></div>
        </div>

        <div class="test-table-scroll">
          <table class="bringup-table" style="margin-top: 0;">
            <thead>
              <tr>
                <th style="width: 26px;"><input type="checkbox" id="testSelectAllCb" title="Select all filtered tests"></th>
                <th style="width: 34px;">#</th>
                <th>Test &amp; Description</th>
                <th style="width: 105px;">Project</th>
                <th style="width: 150px;">Mode / Scenarios</th>
                <th style="width: 115px;">Boards</th>
                <th style="width: 145px;">Target Binary</th>
                <th style="width: 140px;">Status</th>
              </tr>
            </thead>
            <tbody id="testTableBody"></tbody>
          </table>
        </div>

        <div class="test-console-box" id="testConsoleOutput">
          <span class="term-dim">&gt; Click 🔄 Scan or switch to TEST mode to discover @device_test suites.</span>
        </div>
      </div>
    </div>
  </main>

  <footer class="cli-input-bar" id="cliInputBar" style="display: {% if runner.active_mode == 'TEST' %}none{% else %}flex{% endif %};">
    <div id="cliFuzzyHistory" class="cli-fuzzy-history" style="display:none;">
      <div class="fuzzy-header">
        <span class="fuzzy-prompt">(reverse-i-search)`':</span>
        <input type="text" id="fuzzySearchInput" class="fuzzy-search-input" placeholder="Search command history..." autocomplete="off">
        <button class="btn" id="btnCloseFuzzyHistory" style="padding: 1px 6px; font-size: 8.5px;">✕</button>
      </div>
      <div id="fuzzyResultsList" class="fuzzy-results-list"></div>
    </div>
    <span class="prompt-label" id="promptLabel">{% if runner.active_mode == 'FS' %}fs&gt; {% else %}shell&gt; {% endif %}</span>
    <input type="text" id="cmdInput" class="cmd-input" placeholder="{% if runner.active_mode == 'FS' %}Type FS command (e.g. 'ls', 'cat metadata', 'crash-log', 'format')...{% else %}Type shell command (e.g. 'motor speed 100', 'gpio status', 'battery status')...{% endif %}" autofocus autocomplete="off">
    <button class="btn btn-cyan" id="btnSubmitCmd">Send [↵]</button>
  </footer>

  <script id="app-boot-config" type="application/json">
    {{ {
      "package": runner.package | default(none),
      "binName": runner.bin_name | default(none),
      "target": runner.target | default(none),
      "activeMode": runner.active_mode | default("CLI"),
      "release": runner.release | default(false),
      "speed": runner.speed | default(1000),
      "chip": runner.chip | default(none),
      "showSystemLogs": runner.show_system_logs | default(false),
      "packageSelectionMode": package_selection_mode | default(false),
      "targetPackages": target_packages | default([]),
      "lastSession": last_session | default(none)
    } | tojson }}
  </script>
  <script type="module" src="/js/daemon/daemon_app.js"></script>
</body>
</html>
