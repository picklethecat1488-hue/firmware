<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xerxes Perfetto Bridge // {{ trace_title }}</title>
  <meta name="theme-color" content="#04090c">
  <meta name="color-scheme" content="dark">
  <style>
    :root {
      color-scheme: dark;
      --xerxes-bg: #04090c;
      --xerxes-panel: rgba(8, 22, 29, 0.94);
      --xerxes-border: #0b5966;
      --xerxes-cyan: #00f0ff;
      --xerxes-mint: #00ffb4;
      --xerxes-red: #ff2a4b;
      --xerxes-text: #e6f9ff;
      --xerxes-muted: #7aa5b0;
      --font-mono: "Share Tech Mono", ui-monospace, "SF Mono", "Courier New", monospace;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--xerxes-bg);
      color: var(--xerxes-text);
      font-family: var(--font-mono);
    }
    .perfetto-embed-frame {
      width: 100vw;
      height: 100vh;
      border: 0;
      display: block;
      background: #12151a;
    }
    .perfetto-bridge-banner {
      position: fixed;
      top: 10px;
      right: 14px;
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 4px;
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.55);
      font-size: 11px;
      letter-spacing: 0.03em;
    }
    .perfetto-bridge-banner[data-state="ready"] {
      border-color: var(--xerxes-mint);
    }
    .perfetto-bridge-banner[data-state="error"] {
      border-color: var(--xerxes-red);
      color: var(--xerxes-red);
    }
    .bridge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--xerxes-cyan);
      flex-shrink: 0;
    }
    .perfetto-bridge-banner[data-state="ready"] .bridge-dot {
      background: var(--xerxes-mint);
    }
    .perfetto-bridge-banner[data-state="error"] .bridge-dot {
      background: var(--xerxes-red);
    }
    .bridge-btn {
      background: #0d2530;
      color: var(--xerxes-cyan);
      border: 1px solid var(--xerxes-border);
      border-radius: 3px;
      padding: 3px 8px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      cursor: pointer;
    }
    .bridge-btn:hover {
      border-color: var(--xerxes-cyan);
      background: #133645;
    }
    .bridge-btn-close {
      color: var(--xerxes-muted);
      padding: 2px 6px;
    }
  </style>
</head>
<body>
  <div id="perfettoBridgeBanner" class="perfetto-bridge-banner" role="status">
    <span class="bridge-dot"></span>
    <span id="perfettoBridgeStatus">Loading {{ trace_filename }} into Perfetto UI...</span>
    <button type="button" id="perfettoBridgeOpenTabBtn" class="bridge-btn" title="Open standalone ui.perfetto.dev tab via postMessage">↗ Open Standalone Tab</button>
    <button type="button" id="perfettoBridgeDismissBtn" class="bridge-btn bridge-btn-close" title="Dismiss banner">✕</button>
  </div>
  <iframe
    id="perfettoEmbedFrame"
    class="perfetto-embed-frame"
    src="https://ui.perfetto.dev"
    title="Perfetto Trace Viewer"
    allow="clipboard-read; clipboard-write; fullscreen"
  ></iframe>
  <script id="app-boot-config" type="application/json">
    {{ {
      "title": trace_title | default("Firmware Perfetto Trace"),
      "fileName": trace_filename | default("trace.perfetto.json"),
      "traceUrl": trace_url | default("/api/trace/perfetto.json"),
      "eventCount": event_count | default(0)
    } | tojson }}
  </script>
  <script type="module" src="/js/daemon/perfetto_bridge.js"></script>
</body>
</html>
