<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xerxes Worm Matrix - System Shock 2</title>
  <meta name="theme-color" content="#0a1c24">
  <meta name="color-scheme" content="dark">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Xerxes">
  <link rel="manifest" href="/static/manifest.json">
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
  <link rel="shortcut icon" href="/static/favicon.ico">
  <link rel="stylesheet" href="/static/common.css">
  <script src="/static/vendor/highlight/highlight.js"></script>
  <style>
    html {
      font-size: 80%;
      height: 100%;
      width: 100%;
    }
    /* =========================================================
       SYSTEM SHOCK 2 // XERXES WORM MATRIX HUD THEME
       ========================================================= */
    :root {
      --xerxes-bg: #04090c;
      --xerxes-panel: #08161d;
      --xerxes-panel-hover: #0e242f;
      --xerxes-header-bg: #0a1c24;
      --xerxes-border-light: #00f0ff;
      --xerxes-border-mid: #0b5966;
      --xerxes-border-dark: #021217;

      --xerxes-cyan: #00f0ff;
      --xerxes-cyan-dim: #00a4b3;
      --xerxes-teal: #14d9c4;
      --xerxes-mint: #00ffb4;
      --xerxes-amber: #ffb000;
      --xerxes-copper: #14a090;
      --xerxes-red: #ff2a4b;
      --xerxes-green: #00ffb4;
      --xerxes-purple: #c084fc;
      --xerxes-text-light: #e6f9ff;
      --xerxes-text-muted: #7aa5b0;
      --xerxes-text-dim: #3a626c;

      /* Aliases for template classes */
      --quake-bg: var(--xerxes-bg);
      --quake-panel: var(--xerxes-panel);
      --quake-panel-hover: var(--xerxes-panel-hover);
      --quake-header-bg: var(--xerxes-header-bg);
      --quake-border-light: var(--xerxes-border-light);
      --quake-border-mid: var(--xerxes-border-mid);
      --quake-border-dark: var(--xerxes-border-dark);

      --quake-gold: var(--xerxes-cyan);
      --quake-gold-dim: var(--xerxes-cyan-dim);
      --quake-amber: var(--xerxes-amber);
      --quake-copper: var(--xerxes-teal);
      --quake-red: var(--xerxes-red);
      --quake-green: var(--xerxes-green);
      --quake-cyan: var(--xerxes-cyan);
      --quake-purple: var(--xerxes-purple);
      --quake-text-light: var(--xerxes-text-light);
      --quake-text-muted: var(--xerxes-text-muted);
      --quake-text-dim: var(--xerxes-text-dim);

      --font-mono: "Share Tech Mono", ui-monospace, "SF Mono", "Courier New", monospace;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--xerxes-bg);
      background-image:
        repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.38) 0px, rgba(0, 0, 0, 0.38) 2px, transparent 2px, transparent 4px),
        radial-gradient(ellipse at 50% 0%, #0a2f3a 0%, #03080b 100%);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
      height: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 2px solid var(--xerxes-border-mid);
      box-shadow: inset 0 0 0 1px rgba(0, 240, 255, 0.2), 0 0 10px rgba(0, 240, 255, 0.1);
    }

    html.in-iframe,
    html.in-iframe body,
    body.in-iframe {
      border: none !important;
      box-shadow: none !important;
    }
    html.in-iframe .window-resize-gripper,
    body.in-iframe .window-resize-gripper,
    .in-iframe .window-resize-gripper {
      display: none !important;
    }

    /* Window Resize Gripper (WORM-027) */
    .window-resize-gripper {
      position: fixed;
      bottom: 2px;
      right: 2px;
      width: 16px;
      height: 16px;
      cursor: nwse-resize;
      z-index: 99999;
      pointer-events: none;
      background:
        linear-gradient(135deg, transparent 0%, transparent 40%, var(--xerxes-border-mid) 40%, var(--xerxes-border-mid) 50%, transparent 50%, transparent 65%, var(--xerxes-border-light) 65%, var(--xerxes-border-light) 75%, transparent 75%, transparent 90%, var(--xerxes-cyan) 90%, var(--xerxes-cyan) 100%);
      opacity: 0.85;
      filter: drop-shadow(0 0 2px var(--xerxes-cyan));
    }

    /* Visible Quake & Xerxes High-Contrast Scrollbars (BUG-202, BUG-233) */
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--quake-copper, #c87a32) #1e130b;
    }
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #1e130b;
      border: 1px solid #3d2311;
    }
    ::-webkit-scrollbar-thumb {
      background: #965a25;
      border-radius: 4px;
      border: 1px solid #c87a32;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--quake-gold, #ffb800);
      border-color: #ffd700;
      box-shadow: 0 0 6px rgba(255, 184, 0, 0.4);
    }

    /* Xerxes Beveled Panels */
    .quake-card {
      background: var(--xerxes-panel);
      border: 1px solid var(--xerxes-border-mid);
      box-shadow: inset 1px 1px 0 rgba(0, 240, 255, 0.15), 0 4px 12px rgba(0, 0, 0, 0.7);
    }

    /* Quake Modal Dialog */
    .quake-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10000;
    }
    .quake-modal {
      background: var(--quake-panel, var(--xerxes-panel));
      border: 2px solid var(--quake-border-light, var(--xerxes-border-light));
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9), inset 1px 1px 0 var(--quake-border-light, var(--xerxes-border-light));
      border-radius: 4px;
      width: 620px;
      max-width: 90vw;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .quake-modal-header {
      background: var(--quake-header-bg, var(--xerxes-header-bg));
      border-bottom: 2px solid var(--quake-border-mid, var(--xerxes-border-mid));
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--quake-gold, var(--xerxes-cyan));
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Top Bar Header */
    header.quake-header {
      background: var(--xerxes-header-bg);
      border-bottom: 2px solid var(--xerxes-border-light);
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 10px rgba(0, 240, 255, 0.15);
      z-index: 10;
      overflow-x: auto;
      flex-wrap: nowrap;
    }

    .brand-block {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--xerxes-cyan);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
    }

    .metrics-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .metric-pill {
      font-size: 9px;
      color: var(--xerxes-text-muted);
      background: #040d12;
      padding: 4px 10px;
      border: 1px solid var(--xerxes-border-mid);
      border-radius: 3px;
    }

    .metric-highlight {
      font-weight: bold;
      color: var(--xerxes-cyan);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Buttons */
    .quake-btn {
      font-family: var(--font-mono);
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 6px 12px;
      white-space: nowrap !important;
      cursor: pointer;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .quake-btn-default {
      background: #081a22;
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
    }

    .quake-btn-default:hover {
      background: var(--xerxes-panel-hover);
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.25);
    }

    .quake-btn-active {
      background: #0a2f3a !important;
      border-color: var(--xerxes-cyan) !important;
      color: var(--xerxes-cyan) !important;
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.4) !important;
    }

    .quake-btn-gold {
      background: #00363d;
      border: 1px solid var(--xerxes-cyan);
      color: var(--xerxes-cyan);
      font-weight: 700;
    }

    .quake-btn-gold:hover {
      background: #004d57;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }

    .quake-btn-green {
      background: #04291e;
      border: 1px solid var(--xerxes-mint);
      color: var(--xerxes-mint);
      font-weight: 700;
    }

    .quake-btn-green:hover {
      background: #06402e;
      box-shadow: 0 0 10px rgba(0, 255, 180, 0.5);
    }

    .quake-btn-red {
      background: #2b0b11;
      border: 1px solid var(--xerxes-red);
      color: var(--xerxes-red);
      font-weight: 700;
    }

    .quake-btn-red:hover {
      background: #420f18;
      box-shadow: 0 0 10px rgba(255, 42, 75, 0.5);
    }

    .copy-icon-btn {
      background: transparent;
      border: none;
      color: var(--xerxes-text-muted);
      cursor: pointer;
      font-size: 9px;
      padding: 1px 3px;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      transition: all 0.15s ease;
    }

    .copy-icon-btn:hover {
      color: var(--xerxes-cyan);
      background: rgba(0, 240, 255, 0.15);
    }

    /* Main Workspace Layout */
    .main-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* Left Sidebar */
    .sidebar {
      width: 340px;
      background: #040c11;
      border-right: 1px solid var(--xerxes-border-mid);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .sidebar-header {
      padding: 10px;
      border-bottom: 1px solid var(--xerxes-border-mid);
      background: #06141c;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-search {
      width: 100%;
      background: #02070a;
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      padding: 6px 10px;
      font-family: var(--font-mono);
      font-size: 9px;
      border-radius: 2px;
    }

    .sidebar-search:focus {
      outline: none;
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.3);
    }

    .worm-list, .bug-list {
      list-style: none;
      overflow-y: auto;
      flex: 1;
    }

    .worm-item, .bug-item {
      padding: 10px 14px;
      border-bottom: 1px solid #071922;
      cursor: pointer;
      transition: background 0.12s ease;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .worm-item:hover, .bug-item:hover {
      background: #071d27;
    }

    .worm-item.active, .bug-item.active {
      background: #092633;
      border-left: 3px solid var(--xerxes-cyan);
      box-shadow: inset 0 0 12px rgba(0, 240, 255, 0.1);
    }

    .worm-item-top, .bug-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .worm-id, .bug-id {
      font-size: 9px;
      font-weight: bold;
      color: var(--xerxes-cyan);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .worm-item-title, .bug-item-title {
      font-size: 10px;
      color: var(--xerxes-text-light);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Badges */
    .quake-badge {
      font-size: 8px;
      padding: 2px 6px;
      border-radius: 2px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .quake-badge-red { background: #3b0910; color: #ff5772; border: 1px solid #821020; }
    .quake-badge-amber { background: #382404; color: #ffb833; border: 1px solid #805008; }
    .quake-badge-gold { background: #00363d; color: #00f0ff; border: 1px solid #008f9c; }
    .quake-badge-green { background: #04291e; color: #00ffb4; border: 1px solid #008f65; }
    .quake-badge-muted { background: #08161d; color: #7aa5b0; border: 1px solid #143542; }

    /* Content Area */
    .content-area {
      flex: 1;
      overflow-y: auto;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-section {
      padding: 16px 18px;
      border-radius: 3px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .section-title {
      font-size: 10px;
      font-weight: 700;
      color: var(--xerxes-cyan);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-bottom: 1px solid var(--xerxes-border-mid);
      padding-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .row {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    .col {
      display: flex;
      flex-direction: column;
      gap: 5px;
      flex: 1;
    }

    label {
      font-size: 8.5px;
      text-transform: uppercase;
      color: var(--xerxes-text-muted);
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    input[type="text"], select, textarea {
      background: #02070a;
      border: 1px solid var(--xerxes-border-mid);
      color: var(--xerxes-text-light);
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 7px 10px;
      border-radius: 2px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    input[type="text"]:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--xerxes-cyan);
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.3);
    }

    textarea {
      resize: both !important;
      min-height: 80px;
      min-width: 200px;
      max-width: 100%;
      line-height: 1.4;
    }

    input[type="text"] {
      resize: horizontal;
      min-width: 150px;
    }

    /* Attachments Grid */
    .attachments-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 10px;
    }

    .attachment-card {
      background: #040e14;
      border: 1px solid var(--xerxes-border-mid);
      border-radius: 3px;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .attachment-preview {
      width: 100%;
      height: 110px;
      object-fit: cover;
      background: #02070a;
      border: 1px solid #092430;
      border-radius: 2px;
    }

    .document-preview-box {
      width: 100%;
      height: 110px;
      background: #02070a;
      border: 1px solid #092430;
      border-radius: 2px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .doc-icon { font-size: 22px; }
    .doc-type { font-size: 7.5px; color: var(--xerxes-text-muted); font-weight: bold; }

    .attachment-name {
      font-size: 9px;
      color: var(--xerxes-text-light);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .attachment-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 7.5px;
      color: var(--xerxes-text-dim);
    }

    .dropzone {
      border: 2px dashed var(--xerxes-border-mid);
      border-radius: 4px;
      padding: 20px;
      text-align: center;
      color: var(--xerxes-text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      background: rgba(0, 240, 255, 0.02);
      font-size: 9px;
    }

    .dropzone:hover, .dropzone.dragover {
      border-color: var(--xerxes-cyan);
      background: rgba(0, 240, 255, 0.08);
      color: var(--xerxes-cyan);
    }

    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #04242e;
      border: 1px solid var(--xerxes-cyan);
      color: var(--xerxes-cyan);
      padding: 10px 18px;
      border-radius: 3px;
      font-size: 10px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.8), 0 0 10px rgba(0, 240, 255, 0.4);
      display: none;
      z-index: 10000;
    }

    .attachment-lfs-notice {
      font-size: 8px;
      color: var(--xerxes-text-dim);
      margin-top: 4px;
    }
    /* Markdown Preview Box */
    .md-preview-box {
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--quake-border-mid);
      border-radius: 2px;
      padding: 10px 12px;
      min-height: 80px;
      font-size: 11px;
      line-height: 1.55;
      color: var(--quake-text-light);
      overflow-x: auto;
    }
    .md-preview-box h1, .md-preview-box h2, .md-preview-box h3, .md-preview-box h4 {
      color: var(--quake-gold);
      margin: 6px 0 4px 0;
    }
    .md-preview-box p, .md-preview-box ul, .md-preview-box ol, .md-preview-box blockquote {
      margin: 4px 0 8px 0;
    }
    .md-preview-box ul, .md-preview-box ol {
      padding-left: 18px;
    }
    .md-preview-box blockquote {
      border-left: 3px solid var(--quake-gold);
      padding-left: 8px;
      color: var(--quake-text-muted);
    }
    .md-preview-box .md-code-block {
      background: #080503;
      border: 1px solid var(--quake-border-mid);
      border-radius: 2px;
      padding: 8px;
      font-family: var(--font-mono);
      font-size: 10px;
      overflow-x: auto;
      margin: 6px 0;
    }
    .md-preview-box .md-inline-code {
      background: rgba(0, 0, 0, 0.5);
      padding: 1px 4px;
      border-radius: 2px;
      font-family: var(--font-mono);
      color: var(--quake-gold);
    }
  </style>
</head>
<body>

  <!-- Xerxes Top Bar Header -->
  <header class="quake-header">
    <div class="brand-block">
      <span class="brand-title">🪱 SYSTEM SHOCK 2 // XERXES WORM MATRIX</span>
    </div>
    <div class="metrics-group">
      <div class="metric-pill">TOTAL: <span id="m-total" class="metric-highlight">0</span></div>
      <div class="metric-pill">OPEN: <span id="m-open" class="metric-highlight" style="color:var(--quake-amber);">0</span></div>
      <div class="metric-pill">RESOLVED: <span id="m-resolved" class="metric-highlight" style="color:var(--quake-green);">0</span></div>
    </div>
    <div class="header-actions">
      <!-- UI Scale Selector (8715cab2) -->
      <div style="display:flex;align-items:center;gap:4px;margin-right:4px;">
        <span style="font-size:8px;color:var(--quake-text-dim);">SCALE:</span>
        <select id="uiScaleSelect" class="quake-select" title="UI Scale (Shortcuts: Cmd/Ctrl +/- or 0 to reset)" style="padding: 2px 4px; font-size: 8.5px; height: 22px;">
          <option value="75%">75%</option>
          <option value="80%">80%</option>
          <option value="90%">90%</option>
          <option value="100%" selected>100%</option>
          <option value="110%">110%</option>
          <option value="125%">125%</option>
          <option value="150%">150%</option>
        </select>
      </div>
      <span class="quake-badge" style="background:#040d12; border:1px solid var(--quake-gold); color:var(--quake-gold); font-size:9.5px; padding:3px 8px;">Branch: <strong>worms</strong></span>
      <button class="quake-btn quake-btn-default" data-action="sync-feedback">🔄 Sync Feedback</button>
      <button class="quake-btn quake-btn-default" data-action="new-issue">+ New Worm</button>
      <button class="quake-btn quake-btn-gold" id="btn-save-exit" data-action="save-exit">💾 Save and Exit</button>
      <a href="/" target="firmware_vcs_diff_viewer" data-action="close-workstation" class="quake-btn quake-btn-default modal-close-btn" style="text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:bold;font-size:13px;padding:2px 10px;line-height:1;" title="Close workstation (Esc)">✕</a>
    </div>
  </header>

  <!-- Feedback Sync Progress Modal -->
  <div id="feedback-loading-modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); z-index:99999; align-items:center; justify-content:center;">
    <div class="quake-card" style="padding:24px 32px; max-width:480px; width:90%; text-align:center; border:2px solid var(--quake-gold);">
      <h3 style="color:var(--quake-gold); margin-bottom:12px; font-size:13px;">🔄 MERGING AGENT FEEDBACK</h3>
      <p id="loading-status-text" style="color:var(--quake-text-light); font-size:10px; margin-bottom:16px;">Merging stored agent feedback from feedback/ directory into SQLite database...</p>
      <div style="background:#040d12; border:1px solid #0b5966; border-radius:4px; height:14px; position:relative; overflow:hidden; margin-bottom:12px;">
        <div id="loading-progress-bar" style="background:linear-gradient(90deg, #ffaa00, #ff8800); width:15%; height:100%; transition:width 0.1s ease; box-shadow:0 0 10px rgba(255,170,0,0.5);"></div>
        <div id="loading-progress-percent" style="position:absolute; top:0; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; font-size:8px; font-weight:bold; color:#fff; text-shadow:0 1px 2px #000;">15%</div>
      </div>
      <div id="loading-step-text" style="color:var(--quake-text-muted); font-size:9px;">Scanning feedback/ directory for WORM_*.md files...</div>
    </div>
  </div>

  <!-- Action Progress Modal (BUG-327) -->
  <div id="actionProgressModalOverlay" class="quake-modal-overlay" style="display: none; z-index: 99999;">
    <div class="quake-modal" style="width: 480px; max-width: 90vw; padding: 20px 24px; text-align: left;">
      <div class="quake-modal-header" style="padding: 0 0 12px 0; margin-bottom: 12px; border-bottom: 1px solid var(--quake-border-mid); display: flex; align-items: center; justify-content: space-between; background: transparent;">
        <div style="font-size: 11px; font-weight: bold; color: var(--quake-gold); letter-spacing: 1px; display: flex; align-items: center; gap: 8px;">
          <span id="actionProgressIcon">⚡</span>
          <span id="actionProgressTitle">PROCESSING ACTION</span>
        </div>
      </div>

      <div style="font-size: 9px; color: var(--quake-text-muted); margin-bottom: 12px; line-height: 1.4;" id="actionProgressDescription">
        Executing requested operation...
      </div>

      <!-- Progress bar -->
      <div style="background: var(--quake-bg-dark, #040d12); border: 1px solid var(--quake-border-light, #0b5966); border-radius: 3px; height: 16px; position: relative; overflow: hidden; margin-bottom: 12px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.6);">
        <div id="actionProgressBar" style="width: 15%; height: 100%; background: linear-gradient(90deg, #ffaa00, #ff8800); transition: width 0.3s ease; box-shadow: 0 0 10px rgba(255,170,0,0.5);"></div>
        <div id="actionProgressPercent" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: bold; color: #fff; text-shadow: 0 1px 2px #000;">15%</div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: var(--quake-copper, #c47c38); font-family: var(--font-mono, monospace); font-weight: bold;">
        <span id="actionProgressStatus">Working...</span>
        <span id="actionProgressElapsed" style="color: var(--quake-text-dim, #7a6a58);">0.0s</span>
      </div>
    </div>
  </div>

  <!-- Main Container -->
  <div class="main-container">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="sidebar-header" style="flex-direction:column; gap:8px;">
        <input type="text" id="search-input" class="sidebar-search" placeholder="Search worms...">
        <div class="filter-pills" style="display:flex; gap:6px; width:100%;">
          <button id="filter-open" class="quake-btn quake-btn-default quake-btn-active" style="flex:1; padding:4px 6px; font-size:8px;" data-action="set-filter" data-filter="open">OPEN</button>
          <button id="filter-planned" class="quake-btn quake-btn-default" style="flex:1; padding:4px 6px; font-size:8px;" data-action="set-filter" data-filter="planned">PLANNED</button>
          <button id="filter-all" class="quake-btn quake-btn-default" style="flex:1; padding:4px 6px; font-size:8px;" data-action="set-filter" data-filter="all">ALL</button>
          <button id="filter-resolved" class="quake-btn quake-btn-default" style="flex:1; padding:4px 6px; font-size:8px;" data-action="set-filter" data-filter="resolved">RESOLVED</button>
        </div>
        <div style="display:flex; gap:6px; width:100%;">
          <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:7.5px;">Category</label>
            <select id="select-filter-category" style="width:100%; padding:4px; font-size:8px;">
              <option value="ALL">ALL</option>
              {% for cat in categories %}
              <option value="{{ cat }}">{{ cat }}</option>
              {% endfor %}
            </select>
          </div>
          <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:7.5px;">Severity</label>
            <select id="select-filter-severity" style="width:100%; padding:4px; font-size:8px;">
              <option value="ALL">ALL</option>
              {% for sev in severities %}
              <option value="{{ sev }}">{{ sev }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div style="display:flex; flex-direction:column; gap:2px; width:100%;">
          <label style="font-size:7.5px;">Sort By</label>
          <select id="select-worm-sort" style="width:100%; padding:4px; font-size:8px;">
            <option value="id_desc">ID (Newest first)</option>
            <option value="id_asc">ID (Oldest first)</option>
            <option value="severity">Severity (Critical first)</option>
            <option value="status">Status (Open first)</option>
            <option value="component">Component</option>
            <option value="title">Title</option>
          </select>
        </div>
      </div>
      <ul id="worm-list" class="worm-list bug-list"></ul>
    </div>

    <!-- Content Area -->
    <div class="content-area">
      <!-- Functional Review Action Banner -->
      <div id="review-action-banner" class="form-section quake-card review-banner" style="display:none; border:2px solid var(--quake-gold); background:rgba(0,229,255,0.08); margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
          <div>
            <div style="font-size:12px; font-weight:700; color:var(--quake-gold); letter-spacing:1px; display:flex; align-items:center; gap:8px;">
              <span>⚡ FUNCTIONAL REVIEW REQUIRED</span>
              <span style="font-size:9.5px; background:var(--quake-gold); color:#000; padding:2px 6px; border-radius:2px; font-weight:800;">AWAITING EVALUATION</span>
            </div>
            <div style="font-size:11px; color:#ddd; margin-top:4px;">
              Verify functionality, run demo commands below, and inspect device telemetry before accepting fix.
            </div>
          </div>
          <div style="display:flex; gap:10px;">
            <button class="quake-btn quake-btn-green" style="font-weight:700; padding:6px 16px; font-size:10px;" data-action="accept-issue">✔ ACCEPT FIX</button>
            <button class="quake-btn quake-btn-red" style="font-weight:700; padding:6px 16px; font-size:10px;" data-action="reject-issue">✖ REJECT FIX</button>
          </div>
        </div>
      </div>

      <!-- Rejection Feedback Card -->
      <div id="rejection-feedback-card" class="form-section quake-card rejection-banner" style="display:none; border:2px solid #ff4444; background:rgba(255,68,68,0.12); margin-bottom:12px;">
        <div class="section-title" style="color:#ff6666;">
          <span>⚠ REJECTION FEEDBACK - FIX REJECTED BY REVIEWER</span>
        </div>
        <div id="rejection-feedback-text" style="color:#fff; font-size:11px; white-space:pre-wrap; line-height:1.5;"></div>
      </div>

      <!-- Accepted Fix Card -->
      <div id="accepted-feedback-card" class="form-section quake-card accepted-banner" style="display:none; border:2px solid var(--quake-green); background:rgba(34,197,94,0.12); margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
          <div class="section-title" style="color:var(--quake-green); margin-bottom:0;">
            <span>✔ FIX FUNCTIONALLY REVIEWED &amp; ACCEPTED</span>
          </div>
          <span id="accepted-timestamp-display" style="font-size:9.5px; background:var(--quake-green); color:#000; padding:2px 6px; border-radius:2px; font-weight:800;">CLOSED</span>
        </div>
      </div>
      <!-- Worm Identity Section -->
      <div class="form-section quake-card">
        <div class="section-title">
          <span style="display:flex; align-items:center; gap:8px;">
            <span>🪱 Worm Identity</span>
            <span id="active-worm-id-display" class="active-bug-id-display" style="color:var(--quake-gold); font-size:10px;"></span>
            <span id="active-bug-id-display" style="display:none;"></span>
            <button id="btn-copy-active-worm" class="copy-icon-btn copy-badge-btn btn-copy-active-bug" data-action="copy-active-id" title="Copy active worm ID" style="display:none;">📋</button>
          </span>
          <div style="display:flex; gap:8px;">
            <button id="btn-save" class="quake-btn quake-btn-green" data-action="save-issue">Save Worm</button>
            <button id="btn-delete" class="quake-btn quake-btn-red" data-action="delete-issue">Delete</button>
          </div>
        </div>
        <div class="row">
          <div class="col" style="flex:2;">
            <label>Worm Title</label>
            <input type="text" id="worm-title" placeholder="Descriptive title of the issue...">
          </div>
          <div class="col">
            <label>Severity</label>
            <select id="worm-severity">
              {% for sev in severities %}
              <option value="{{ sev }}">{{ sev }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col">
            <label>Status</label>
            <select id="worm-status">
              {% for st in statuses %}
              <option value="{{ st }}">{{ st }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col">
            <label>Category</label>
            <select id="worm-category">
              {% for cat in categories %}
              <option value="{{ cat }}">{{ cat }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col">
            <label>Component</label>
            <input type="text" id="worm-component" placeholder="e.g. carrier_board, driver, U1" list="worm-component-list">
            <datalist id="worm-component-list">
              {% if components is defined and components %}
                {% for comp in components %}
                <option value="{{ comp }}"></option>
                {% endfor %}
              {% else %}
                {% set worms_list = (database.worms if database and database.worms is defined else (database.bugs if database and database.bugs is defined else [])) %}
                {% if worms_list %}
                {% for comp in worms_list | map(attribute='component', default='') | reject('none') | map('trim') | reject('equalto', '') | unique | sort %}
                <option value="{{ comp }}"></option>
                {% endfor %}
                {% endif %}
              {% endif %}
            </datalist>
          </div>
        </div>
      </div>

      <!-- Description Section -->
      <div class="form-section quake-card">
        <div class="section-title">
          <span>Description & Details</span>
          <div style="display:flex; gap:6px;">
            <button type="button" class="panel-expand-btn quake-btn quake-btn-default" data-action="toggle-md-preview" data-target-textarea="worm-description" data-target-preview="worm-description-preview" title="Toggle Markdown preview">👁 Preview</button>
            <button type="button" class="panel-expand-btn quake-btn quake-btn-default" data-action="toggle-expand-panel" title="Extend panel vertically">⤢ Expand</button>
          </div>
        </div>
        <div class="col">
          <label>Problem Description</label>
          <textarea id="worm-description" placeholder="Comprehensive explanation of defect or invariant failure..."></textarea>
          <div id="worm-description-preview" class="md-preview-box" style="display:none;"></div>
        </div>
        <div class="col">
          <label>Reproduction Steps (one per line)</label>
          <textarea id="worm-steps" placeholder="1. Run target build&#10;2. Observe DMA fault&#10;3. Inspect register"></textarea>
        </div>
        <div class="row">
          <div class="col">
            <label>Expected Behavior</label>
            <textarea id="worm-expected" style="min-height:60px;" placeholder="What should have happened..."></textarea>
          </div>
          <div class="col">
            <label>Actual Behavior</label>
            <textarea id="worm-actual" style="min-height:60px;" placeholder="What actually occurred..."></textarea>
          </div>
        </div>
      </div>

      <!-- Logs Section -->
      <div class="form-section quake-card">
        <div class="section-title">
          <span>Execution Logs & Tracebacks</span>
          <button class="panel-expand-btn quake-btn quake-btn-default" data-action="toggle-expand-panel" title="Extend panel vertically">⤢ Expand</button>
        </div>
        <div class="col">
          <label>Console Output / Target Log</label>
          <textarea id="worm-logs" style="font-family:var(--font-mono); min-height:100px;" placeholder="Paste runtime failure logs or traceback here..."></textarea>
        </div>
      </div>

      <!-- Attachments Section -->
      <div class="form-section quake-card" id="attachments-section">
        <div class="section-title">
          <span>Attachments & Trace Dumps</span>
          <button class="quake-btn quake-btn-default" data-action="paste-clipboard" style="font-size:8px; padding:3px 8px;">📋 Paste Clipboard</button>
        </div>
        <div id="dropzone" class="dropzone">
          <div>📥 Drag & Drop Screenshots, Logs, or PDF Documents Here (or click to browse)</div>
          <div style="font-size:9.5px; margin-top:4px; color:var(--xerxes-text-dim);">Press ⌘V / Ctrl+V anywhere to paste images or logs</div>
          <div class="attachment-lfs-notice">Attachments are tracked in GitHub LFS and considered non-confidential.</div>
        </div>
        <input type="file" id="file-input" style="display:none;" multiple>
        <div id="attachments-grid" class="attachments-grid"></div>
      </div>

      <!-- Resolution Section -->
      <div class="form-section quake-card">
        <div class="section-title">
          <span>Resolution Notes</span>
          <div style="display:flex; gap:6px;">
            <button type="button" class="panel-expand-btn quake-btn quake-btn-default" data-action="toggle-md-preview" data-target-textarea="worm-resolution" data-target-preview="worm-resolution-preview" title="Toggle Markdown preview">👁 Preview</button>
            <button type="button" class="panel-expand-btn quake-btn quake-btn-default" data-action="toggle-expand-panel" title="Extend panel vertically">⤢ Expand</button>
          </div>
        </div>
        <div class="col">
          <label>Fix Description & Root Cause</label>
          <textarea id="worm-resolution" placeholder="Detailed notes explaining how the defect was remediated..."></textarea>
          <div id="worm-resolution-preview" class="md-preview-box" style="display:none;"></div>
        </div>
      </div>

      <!-- Attached Commits Section -->
      <div class="form-section quake-card" id="attached-commits-section">
        <div class="section-title">
          <span>Attached Commits</span>
        </div>
        <div style="display:flex; gap:8px; margin-bottom:10px;">
          <input type="text" id="input-attach-commit" placeholder="Git commit SHA (e.g. 7f3b89a)..." style="flex:1;">
          <button class="quake-btn quake-btn-default" data-action="attach-commit">+ Attach Commit</button>
        </div>
        <div id="attached-commits-list" class="commits-list" style="display:flex; flex-wrap:wrap; gap:8px;"></div>
      </div>

      <!-- Functional Review Checklist & Demo Commands -->
      <div class="form-section quake-card" id="review-tasks-section">
        <div class="section-title">
          <span>Review Tasks & Functional Checklist</span>
        </div>
        <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
          <input type="text" id="input-task-title" placeholder="Task title / verification requirement..." style="flex:2; min-width:200px;">
          <input type="text" id="input-task-command" placeholder="Demo command (e.g. python tools/host.py cli ping)..." style="flex:3; min-width:250px; font-family:var(--font-mono);">
          <button class="quake-btn quake-btn-default" data-action="add-review-task">+ Add Task</button>
        </div>
        <div id="review-tasks-list" class="tasks-list"></div>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script id="app-boot-config" type="application/json">
    {
      "repoName": "firmware",
      "entityKind": "worm",
      "entityLabel": "WORM",
      "entityTitle": "Worm",
      "collectionKey": "worms",
      "fieldPrefix": "worm",
      "apiBase": "/api/worms",
      "databaseEndpoint": "/api/worms",
      "nextIdEndpoint": "/api/next_worm_id",
      "uploadEndpoint": "/api/upload",
      "syncEndpoint": "/api/sync_feedback",
      "exitEndpoint": "/api/exit",
      "versionEndpoint": "/api/version",
      "defaultCategory": "FIRMWARE",
      "fileInputId": "file-input",
      "itemIcon": "🪱 ",
      "entityIdParam": "worm_id",
      "reviewFromParam": "worms"
    }
  </script>
  <script id="initial-tracker-db" type="application/json">{{ database_json | safe if database_json is defined else '{"title":"Firmware Engineering Worm Tracker","worms":[]}' }}</script>
  <script type="module" src="/js/tracker/tracker_app.js"></script>
  <div class="window-resize-gripper" title="Resize Window" aria-label="Resize Window"></div>
</body>
</html>
