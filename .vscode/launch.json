{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Host Daemon: Attach Shell Core 0 (GDB)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_shell",
      "gdbTarget": "127.0.0.1:${input:gdbCore0Port}",
      "device": "RP2040",
      "overrideRestartCommands": [
        "monitor reset halt",
        "flushregs"
      ],
      "sourceFileMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Host Daemon: Attach Shell Core 1 (GDB)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_shell",
      "gdbTarget": "127.0.0.1:${input:gdbCore1Port}",
      "device": "RP2040",
      "overrideRestartCommands": [
        "monitor reset halt",
        "flushregs"
      ],
      "sourceFileMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Host Daemon: Attach App Core 0 (GDB)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_app",
      "gdbTarget": "127.0.0.1:${input:gdbCore0Port}",
      "device": "RP2040",
      "overrideRestartCommands": [
        "monitor reset halt",
        "flushregs"
      ],
      "sourceFileMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Host Daemon: Attach App Core 1 (GDB)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_app",
      "gdbTarget": "127.0.0.1:${input:gdbCore1Port}",
      "device": "RP2040",
      "overrideRestartCommands": [
        "monitor reset halt",
        "flushregs"
      ],
      "sourceFileMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Host Daemon: Attach Carrier Board Shell (GDB)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/carrier_board_shell",
      "gdbTarget": "127.0.0.1:${input:gdbCore0Port}",
      "device": "MCXN947",
      "overrideRestartCommands": [
        "monitor reset halt",
        "flushregs"
      ],
      "sourceFileMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Debug Current Test File (Pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-o",
        "addopts=",
        "-v",
        "-s",
        "--maxfail=1",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools:${workspaceFolder}/tools/validation:${workspaceFolder}/tools/helpers:${workspaceFolder}/tools/dashboard"
      }
    },
    {
      "name": "Python: Debug Device Test (-k Filter)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/host.py",
      "args": [
        "test",
        "-k",
        "${input:deviceTestKeyword}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools:${workspaceFolder}/tools/validation:${workspaceFolder}/tools/helpers:${workspaceFolder}/tools/dashboard"
      }
    },
    {
      "name": "Python: Debug Manual Bringup Suite (--manual)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/host.py",
      "args": [
        "test",
        "--project",
        "${input:bringupProject}",
        "--scenario",
        "bringup",
        "--manual"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools:${workspaceFolder}/tools/validation:${workspaceFolder}/tools/helpers:${workspaceFolder}/tools/dashboard"
      }
    },
    {
      "name": "Python: Attach to host.py test --debug (Port 5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "Python: Debug Host Daemon (tools/host.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/host.py",
      "args": [
        "--no-detach"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/tools:${workspaceFolder}/tools/validation:${workspaceFolder}/tools/helpers:${workspaceFolder}/tools/dashboard"
      }
    },
    {
      "name": "Rust: Debug Tests in Current File (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--test",
          "${fileBasenameNoExtension}"
        ]
      },
      "args": [
        "--nocapture"
      ],
      "cwd": "${workspaceFolder}",
      "sourceMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Rust: Debug Single Test by Name (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--test",
          "${fileBasenameNoExtension}"
        ]
      },
      "args": [
        "${input:rustTestFilter}",
        "--nocapture"
      ],
      "cwd": "${workspaceFolder}",
      "sourceMap": {
        "firmware": "${workspaceFolder}"
      }
    },
    {
      "name": "Rust: Debug Host Tool (host_cli / host_fs / host_debug)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--package",
          "${input:hostToolPackage}",
          "--bin",
          "${input:hostToolPackage}"
        ]
      },
      "args": [
        "--elf",
        "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_shell"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "JS: Debug Current Test File (node --test)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "node",
      "args": [
        "--test",
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "probe-rs (Secondary): Debug Shell (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_shell",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showTimestamps": true
            },
            {
              "channelNumber": 1,
              "dataFormat": "String"
            }
          ]
        }
      ],
      "preLaunchTask": "cargo: build cat_detector_shell (debug)"
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "probe-rs (Secondary): Debug Firmware (RP2040)",
      "cwd": "${workspaceFolder}",
      "chip": "RP2040",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/cat_detector_app",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showTimestamps": true
            }
          ]
        }
      ],
      "preLaunchTask": "cargo: build cat_detector_app (debug)"
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "probe-rs (Secondary): Debug Carrier Board Shell (MCXN947)",
      "cwd": "${workspaceFolder}",
      "chip": "MCXN947",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv6m-none-eabi/debug/carrier_board_shell",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showTimestamps": true
            },
            {
              "channelNumber": 1,
              "dataFormat": "String"
            }
          ]
        }
      ],
      "preLaunchTask": "cargo: build carrier_board_shell (debug)"
    }
  ],
  "compounds": [
    {
      "name": "Host Daemon: Attach Shell Dual-Core (GDB)",
      "configurations": [
        "Host Daemon: Attach Shell Core 0 (GDB)",
        "Host Daemon: Attach Shell Core 1 (GDB)"
      ]
    },
    {
      "name": "Host Daemon: Attach App Dual-Core (GDB)",
      "configurations": [
        "Host Daemon: Attach App Core 0 (GDB)",
        "Host Daemon: Attach App Core 1 (GDB)"
      ]
    }
  ],
  "inputs": [
    {
      "id": "gdbCore0Port",
      "type": "promptString",
      "description": "Core 0 GDB RSP TCP port exposed by host.py / host_debug",
      "default": "3333"
    },
    {
      "id": "gdbCore1Port",
      "type": "promptString",
      "description": "Core 1 GDB RSP TCP port exposed by host.py / host_debug",
      "default": "3334"
    },
    {
      "id": "deviceTestKeyword",
      "type": "promptString",
      "description": "Pytest -k test name/keyword expression (e.g. tof_proximity or battery and not alert)",
      "default": "tof_proximity"
    },
    {
      "id": "bringupProject",
      "type": "pickString",
      "description": "Target firmware project for manual bringup debugging",
      "options": [
        "cat_detector",
        "carrier_board"
      ],
      "default": "cat_detector"
    },
    {
      "id": "rustTestFilter",
      "type": "promptString",
      "description": "Rust test function name or substring filter",
      "default": ""
    },
    {
      "id": "hostToolPackage",
      "type": "pickString",
      "description": "Host Rust diagnostic binary to build and debug",
      "options": [
        "host_cli",
        "host_fs",
        "host_debug",
        "code_gen"
      ],
      "default": "host_cli"
    }
  ]
}
