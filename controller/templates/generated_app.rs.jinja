/// Setup shell pointers and resolve device handles.
///
/// Parameters:
/// - `fs_buffer`: Static mut filesystem working buffer.
/// - `controllers`: Reference to all active controllers.
/// - `board`: Reference to the board peripherals.
///
/// Returns:
/// Struct containing mapped pointer endpoints for interactive bringup shell commands.
/// Setup shell pointers and resolve device handles.
///
/// Parameters:
/// - `$fs_buffer`: Static mut filesystem working buffer.
/// - `$controllers`: Reference to all active controllers.
/// - `$board`: Reference to the board peripherals.
/// - `$pointers_name`: Name of the variable to bind the resolved ShellControllerPointers to.
#[macro_export]
macro_rules! declare_shell_pointers {
    ($fs_buffer:expr, $controllers:expr, $board:expr, $pointers_name:ident) => {
        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let board_buses = $board.take_buses();
        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let board_i2c_ptr = board_buses
            .i2c
            .lock()
            .await
            .i2c
            .as_mut()
            .map(|i2c| i2c as *mut _ as *mut _)
            .unwrap_or(core::ptr::null_mut());

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let temp_sensor_ptr = $board
            .temp_sensor
            .lock()
            .await
            .0
            .as_mut()
            .map(|sensor| sensor as *mut $crate::Rp2040TempSensor)
            .unwrap_or(core::ptr::null_mut());

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let panic_flash_ptr = unsafe { ::rp2040::get_panic_flash_ptr() as *mut _ };

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let flash_partitions = [
            {%- for p in partitions %}
            controller::NamedPartition {
                name: "{{ p.name }}",
                partition: controller::FlashPartition {
                    flash_ptr: panic_flash_ptr,
                    start_address: {{ p.start_address }},
                    end_address: {{ p.end_address }},
                },
                kind: controller::PartitionKind::{{ p.kind }},
            },
            {%- endfor %}
        ];

        {%- for entry in shell_groups %}
        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let {{ entry.0 }} = [
            {%- for item in entry.1 %}
            controller::NamedDevice {
                name: "{{ item.shell_name }}",
                device: {{ item.ptr|safe }} as *mut _,
            },
            {%- endfor %}
        ];
        {%- endfor %}

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let i2c_buses = [controller::NamedDevice {
            name: "default",
            device: board_i2c_ptr,
        }];

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let temp_sensors_array = [controller::NamedDevice {
            name: "cpu",
            device: temp_sensor_ptr,
        }];

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let temp_sensors = if !temp_sensor_ptr.is_null() {
            &temp_sensors_array[..]
        } else {
            &[]
        };

        #[cfg(all(target_arch = "arm", target_os = "none"))]
        let $pointers_name = controller::shell_controller::ShellControllerPointers::<$crate::{{ shell_config }}> {
            i2c_buses: &i2c_buses[..],
            {%- for entry in shell_groups %}
            {{ entry.0 }}: &{{ entry.0 }}[..],
            {%- endfor %}
            flash_partitions: &flash_partitions[..],
            temp_sensors,
            fs_buffer: $fs_buffer,
        };

        #[cfg(not(all(target_arch = "arm", target_os = "none")))]
        let _ = $fs_buffer;
        #[cfg(not(all(target_arch = "arm", target_os = "none")))]
        let _ = $controllers;
        #[cfg(not(all(target_arch = "arm", target_os = "none")))]
        let _ = $board;
        #[cfg(not(all(target_arch = "arm", target_os = "none")))]
        let $pointers_name = controller::shell_controller::ShellControllerPointers::<{{ shell_config }}>::default();
    };
}

