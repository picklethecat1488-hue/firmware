/// Spawns only the controllers that are enabled in app.toml.
#[macro_export]
macro_rules! spawn_active_controllers {
    // With explicit telemetry channel
    (
        $spawner:expr,
        telemetry: $telemetry:expr,
        controllers: {
            $( $cname:ident ( $ctrl:expr, $rx:ident $(, $extra_rx:expr)* ) , generics: ($($gen:tt)*) ),* $(,)?
        }
    ) => {
        $(
            $crate::spawn_active_single_controller!(
                $spawner,
                $cname,
                $ctrl,
                $rx,
                $telemetry,
                ($( $extra_rx ),*),
                ($($gen)*)
            );
        )*
    };

    // Without explicit telemetry channel (defaults to DUMMY_TELEMETRY_CHANNEL)
    (
        $spawner:expr,
        controllers: {
            $( $cname:ident ( $ctrl:expr, $rx:ident $(, $extra_rx:expr)* ) , generics: ($($gen:tt)*) ),* $(,)?
        }
    ) => {
        $crate::spawn_active_controllers!(
            $spawner,
            telemetry: $crate::DUMMY_TELEMETRY_CHANNEL,
            controllers: {
                $( $cname ( $ctrl, $rx $(, $extra_rx)* ) , generics: ($($gen)*) ),*
            }
        );
    };
}

