/// Configuration trait for the ShellController.
/// Encapsulates the target-specific raw mutex and peripheral types.
pub trait ShellConfig {
    /// Type of the physical flash peripheral.
    type Flash: embedded_storage::nor_flash::NorFlash + 'static;
    {%- for field in cli_resolver_fields %}
    /// {{ field.doc }}
    type {{ field.associated_type }}: {{ field.bounds()|safe }};
    {%- endfor %}


    /// Trigger a panic/crash on a specific core.
    fn trigger_core_panic(
        _resolver: &crate::shell_controller::ShellController<'_, Self>,
        core_id: u32,
    ) -> Result<(), &'static str>
    where
        Self: Sized,
    {
        if core_id == 0 {
            panic!("Simulated Core 0 panic");
        } else {
            Err("Core 1 panic not supported on this platform/configuration")
        }
    }
}

