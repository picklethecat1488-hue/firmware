    pub fn has_pending_command(&self) -> bool {
        self.pending_command.is_some()
    }

    /// Executes the currently pending deferred async command.
    pub async fn execute_pending<W, E>(
        &mut self,
        writer: &mut crate::embedded_cli::writer::Writer<'_, W, E>,
    ) -> Result<(), &'static str>
    where
        W: crate::embedded_io::Write<Error = E>,
        E: crate::embedded_io::Error,
    {
        if let Some(pending) = self.pending_command.take() {
            match pending {
                {%- for cmd in cli_commands %}
                {%- if cmd.async_cli %}
                crate::PendingCommand::{{ cmd.variant }} { subcommand, {%- for arg in cmd.args_slice() %}{{ arg.name }}, {% endfor %} } => {
                    {%- if cmd.handler.contains("::") && !cmd.handler.starts_with("platform::") %}
                    crate::{{ cmd.handler|safe }}(self, subcommand, {%- for arg in cmd.args_slice() %}{% if arg.arg_type == "string" %}{{ arg.name }}.as_deref(){% else %}{{ arg.name }}{% endif %}, {% endfor %} writer).await?;
                    {%- else %}
                    {{ cmd.handler|safe }}(self, subcommand, {%- for arg in cmd.args_slice() %}{% if arg.arg_type == "string" %}{{ arg.name }}.as_deref(){% else %}{{ arg.name }}{% endif %}, {% endfor %} writer).await?;
                    {%- endif %}
                }
                {%- endif %}
                {%- endfor %}
            }
        }
        Ok(())
    }
}
