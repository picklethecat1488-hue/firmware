impl<'a, C: crate::shell_controller::ShellConfig> crate::shell_controller::ShellController<'a, C> {
    /// Prints the subcommands help menu for a given command.
    pub fn print_subcommands_help<W, E>(&self, command: &str, writer: &mut crate::embedded_cli::writer::Writer<'_, W, E>)
    where
        W: crate::embedded_io::Write<Error = E>,
        E: crate::embedded_io::Error,
    {
        use core::fmt::Write as _;
        match command {
            {%- for cmd in cli_commands %}
            "{{ cmd.cmd_name }}" => {
                {%- if !cmd.get_subcommands(subcommands_map).is_empty() %}
                let _ = core::writeln!(writer, "\r\nSubcommands:");
                {%- for sub in cmd.get_subcommands(subcommands_map) %}
                let doc = "{{ sub.doc }}";
                let _ = core::writeln!(writer, "  {:<15} {}", "{{ sub.name }}", doc);
                {%- endfor %}
                {%- endif %}
            }
            {%- endfor %}
            _ => {}
        }
    }
}

